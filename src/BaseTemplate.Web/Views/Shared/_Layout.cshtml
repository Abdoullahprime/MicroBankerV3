@* src/BaseTemplate.Web/Views/Shared/_Layout.cshtml *@
@using BaseTemplate.Web.Models
@inject BaseTemplate.Web.Services.IPermissionService PermissionService
@{
    var perms       = await PermissionService.GetCurrentAsync();
    var activeGroup = ViewData["ActiveGroup"]?.ToString();
    var appName     = "Base Template";   // rename per project
}
<!DOCTYPE html>
<html data-bs-theme="light" lang="en-US" dir="ltr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - @appName</title>

    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/img/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/img/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/img/favicons/favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicons/favicon.ico">
    <link rel="manifest" href="/manifest.json">
    <meta name="msapplication-TileImage" content="/assets/img/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#2c7be5">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="@appName">

    <script src="~/assets/js/config.js"></script>
    <script src="~/vendors/simplebar/simplebar.min.js"></script>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800,900&amp;display=swap" rel="stylesheet">
    <link href="~/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link href="~/assets/css/theme-rtl.css" rel="stylesheet" id="style-rtl">
    <link href="~/assets/css/theme.css" rel="stylesheet" id="style-default">
    <link href="~/assets/css/user-rtl.css" rel="stylesheet" id="user-style-rtl">
    <link href="~/assets/css/user.css" rel="stylesheet" id="user-style-default">

    <script>
        var isRTL = JSON.parse(localStorage.getItem('isRTL'));
        if (isRTL) {
        var linkDefault = document.getElementById('style-default');
        var userLinkDefault = document.getElementById('user-style-default');
        linkDefault.setAttribute('disabled', true);
        userLinkDefault.setAttribute('disabled', true);
        document.querySelector('html').setAttribute('dir', 'rtl');
        } else {
        var linkRTL = document.getElementById('style-rtl');
        var userLinkRTL = document.getElementById('user-style-rtl');
        linkRTL.setAttribute('disabled', true);
        userLinkRTL.setAttribute('disabled', true);
        }
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <main class="main" id="top">
        <div class="container" data-layout="container">

            <script>
                var isFluid = JSON.parse(localStorage.getItem('isFluid'));
                if (isFluid) {
                var container = document.querySelector('[data-layout]');
                container.classList.remove('container');
                container.classList.add('container-fluid');
                }
            </script>

            <!-- ============================================================
           VERTICAL SIDEBAR
           To add a feature: add a Modules constant + DbSeeder row, then a <partial name="_NavLink"> here.
           ============================================================ -->
            <nav class="navbar navbar-light navbar-glass  navbar-vertical navbar-expand-xl navbar-card">
                <script>
                    document.querySelector('.navbar-vertical').classList.add('navbar-card');
                </script>

                <div class="d-flex align-items-center">
                    <div class="toggle-icon-wrapper">
                        <button class="btn navbar-toggler-humburger-icon navbar-vertical-toggle"
                                data-bs-toggle="tooltip" data-bs-placement="left" title="Toggle Navigation">
                            <span class="navbar-toggle-icon"><span class="toggle-line"></span></span>
                        </button>
                    </div>
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <div class="d-flex align-items-center py-2" style="min-width: 0; line-height: 1;">
                            <img class="me-1" src="~/assets/img/logo.png" alt="" width="40" style="flex-shrink: 0;" />
                            <span class="font-sans-serif text-primary fw-bold text-start" style="font-size: 1.4rem; line-height: 1;">@appName</span>
                        </div>
                    </a>
                </div>

                <div class="collapse navbar-collapse mt-3" id="navbarVerticalCollapse">
                    <div class="navbar-vertical-content scrollbar">
                        <ul class="navbar-nav flex-column mb-3" id="navbarVerticalNav">

                            <!-- ── DASHBOARD ──────────────────────────────────── -->
                            <partial name="_NavLink" model='new NavLinkModel(null, "Home", "Index", "fas fa-tachometer-alt", "Dashboard", "Dashboard")' />

                            <!-- ── SETUP ──────────────────────────────────────── -->
                            @if (perms.CanAny(Modules.Organization, Modules.Branches, Modules.Departments, Modules.Units, Modules.Positions, Modules.Banks))
                            {
                                <li class="nav-item">
                                    <div class="row navbar-vertical-label-wrapper mt-3 mb-2">
                                        <div class="col-auto navbar-vertical-label">Setup</div>
                                        <div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div>
                                    </div>

                                    <a class="nav-link dropdown-indicator @(activeGroup == "Org" ? "" : "collapsed")"
                                       href="#nav-org" role="button" data-bs-toggle="collapse"
                                       aria-expanded="@(activeGroup == "Org" ? "true" : "false")" aria-controls="nav-org">
                                        <div class="d-flex align-items-center">
                                            <span class="nav-link-icon"><span class="fas fa-sitemap"></span></span>
                                            <span class="nav-link-text ps-1">Organization Setup</span>
                                        </div>
                                    </a>
                                    <ul class="nav collapse @(activeGroup == "Org" ? "show" : "")" id="nav-org">
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.Organization, "Organization", "Index", "fas fa-building", "Organization", "Organization")' />
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.Branches, "Branch", "Index", "fas fa-code-branch", "Branches", "Branches")' />
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.Departments, "Department", "Index", "fas fa-layer-group", "Departments", "Departments")' />
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.Units, "Unit", "Index", "fas fa-cubes", "Units", "Units")' />
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.Positions, "Position", "Index", "fas fa-user-tag", "Positions", "Positions")' />
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.Banks, "Bank", "Index", "fas fa-university", "Banks", "Banks")' />
                                    </ul>
                                </li>
                            }

                            <!-- ── CALENDAR ───────────────────────────────────── -->
                            @if (perms.CanAny(Modules.WorkCalendar, Modules.PublicHolidays))
                            {
                                <li class="nav-item">
                                    <a class="nav-link dropdown-indicator @(activeGroup == "Calendar" ? "" : "collapsed")"
                                       href="#nav-calendar" role="button" data-bs-toggle="collapse"
                                       aria-expanded="@(activeGroup == "Calendar" ? "true" : "false")" aria-controls="nav-calendar">
                                        <div class="d-flex align-items-center">
                                            <span class="nav-link-icon"><span class="fas fa-calendar-alt"></span></span>
                                            <span class="nav-link-text ps-1">Calendar</span>
                                        </div>
                                    </a>
                                    <ul class="nav collapse @(activeGroup == "Calendar" ? "show" : "")" id="nav-calendar">
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.WorkCalendar, "Calendar", "Index", "fas fa-calendar-check", "Work Calendar", "WorkCalendar")' />
                                        <partial name="_NavLink" model='new NavLinkModel(Modules.PublicHolidays, "PublicHoliday", "Index", "fas fa-flag", "Public Holidays", "PublicHoliday")' />
                                    </ul>
                                </li>
                            }

                            <!-- ── ADMINISTRATION ─────────────────────────────── -->
                            <li class="nav-item">
                                <div class="row navbar-vertical-label-wrapper mt-3 mb-2">
                                    <div class="col-auto navbar-vertical-label">Administration</div>
                                    <div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div>
                                </div>

                                <a class="nav-link dropdown-indicator @(activeGroup == "Administration" ? "" : "collapsed")"
                                   href="#nav-admin" role="button" data-bs-toggle="collapse"
                                   aria-expanded="@(activeGroup == "Administration" ? "true" : "false")" aria-controls="nav-admin">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon"><span class="fas fa-shield-alt"></span></span>
                                        <span class="nav-link-text ps-1">Security &amp; Settings</span>
                                    </div>
                                </a>
                                <ul class="nav collapse @(activeGroup == "Administration" ? "show" : "")" id="nav-admin">
                                    <partial name="_NavLink" model='new NavLinkModel(Modules.Users, "Users", "Index", "fas fa-user-cog", "Users", "Users")' />
                                    <partial name="_NavLink" model='new NavLinkModel(Modules.Roles, "Roles", "Index", "fas fa-id-badge", "Roles", "Roles")' />
                                    <partial name="_NavLink" model='new NavLinkModel(Modules.Permissions, "Permissions", "Index", "fas fa-key", "Permissions", "Permissions")' />
                                    <partial name="_NavLink" model='new NavLinkModel(null, "Account", "Signature", "fas fa-pen-nib", "My Signature", "Signature")' />
                                    <partial name="_NavLink" model='new NavLinkModel(Modules.EmailConfig, "EmailConfig", "Settings", "fas fa-envelope-open-text", "Email Configuration", "EmailConfig")' />
                                    <partial name="_NavLink" model='new NavLinkModel(Modules.SystemSettings, "SystemSettings", "Index", "fas fa-cogs", "System Settings", "SystemSettings")' />
                                </ul>
                            </li>

                        </ul>
                    </div>
                </div>
            </nav>

            <!-- ============================================================
           CONTENT WRAPPER
           ============================================================ -->
            <div class="content">

                <!-- TOP NAVBAR -->
                <nav class="navbar  navbar-light  navbar-glass navbar-top navbar-expand">

                    <button class="btn navbar-toggler-humburger-icon navbar-toggler me-1 me-sm-3"
                            type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarVerticalCollapse"
                            aria-controls="navbarVerticalCollapse"
                            aria-expanded="false" aria-label="Toggle Navigation">
                        <span class="navbar-toggle-icon"><span class="toggle-line"></span></span>
                    </button>

                    <a class="navbar-brand me-1 me-sm-3" asp-controller="Home" asp-action="Index">
                        <div class="d-flex align-items-center py-2" style="min-width: 0;">
                            <img class="me-1" src="~/assets/img/logo.png" alt="" width="40" style="flex-shrink: 0;" />
                            <span class="font-sans-serif text-primary fw-bold text-start" style="font-size: 1.4rem; line-height: 1;">@appName</span>
                        </div>
                    </a>

                    <vc:org-logo></vc:org-logo>

                    <ul class="navbar-nav navbar-nav-icons ms-auto flex-row align-items-center">

                        <!-- Theme switcher -->
                        <li class="nav-item ps-2 pe-0">
                            <div class="dropdown theme-control-dropdown">
                                <a class="nav-link d-flex align-items-center dropdown-toggle fa-icon-wait fs-0 pe-1 py-0"
                                   href="#" role="button" id="themeSwitchDropdown"
                                   data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="fas fa-sun fs-2" data-fa-transform="shrink-2" data-theme-dropdown-toggle-icon="light"></span>
                                    <span class="fas fa-moon fs-2" data-fa-transform="shrink-3" data-theme-dropdown-toggle-icon="dark"></span>
                                    <span class="fas fa-adjust fs-2" data-fa-transform="shrink-2" data-theme-dropdown-toggle-icon="auto"></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-caret border py-0 mt-3"
                                     aria-labelledby="themeSwitchDropdown">
                                    <div class="bg-white dark__bg-1000 rounded-2 py-2">
                                        <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                                                value="light" data-theme-control="theme">
                                            <span class="fas fa-sun"></span>Light
                                            <span class="fas fa-check dropdown-check-icon ms-auto text-600"></span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                                                value="dark" data-theme-control="theme">
                                            <span class="fas fa-moon"></span>Dark
                                            <span class="fas fa-check dropdown-check-icon ms-auto text-600"></span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                                                value="auto" data-theme-control="theme">
                                            <span class="fas fa-adjust"></span>Auto
                                            <span class="fas fa-check dropdown-check-icon ms-auto text-600"></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </li>

                        <partial name="_NotificationBell" />

                        <!-- User dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link pe-0 ps-2" id="navbarDropdownUser" role="button"
                               data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <div class="avatar avatar-xl">
                                    <div class="avatar-name rounded-circle bg-primary-subtle text-primary">
                                        <span>@ViewData["Initials"]</span>
                                    </div>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-caret dropdown-menu-end py-0"
                                 aria-labelledby="navbarDropdownUser">
                                <div class="bg-white dark__bg-1000 rounded-2 py-2">
                                    <div class="px-3 pt-2 pb-2 border-bottom">
                                        <p class="fw-bold mb-0 text-800 fs--1">@ViewData["UserName"]</p>
                                        <span class="badge badge-subtle-success fs--2 mt-1">
                                            <span class="fas fa-shield-alt me-1"></span>@ViewData["UserRole"]
                                        </span>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item fs--1 py-2" asp-controller="Auth" asp-action="ChangePassword">
                                        <span class="fas fa-key me-2"></span>Change Password
                                    </a>
                                    <a class="dropdown-item fs--1 py-2 text-danger"
                                       asp-controller="Auth" asp-action="Logout">
                                        <span class="fas fa-sign-out-alt me-2"></span>Logout
                                    </a>
                                </div>
                            </div>
                        </li>

                    </ul>
                </nav>
                <!-- /TOP NAVBAR -->
                @RenderBody()

                <footer class="footer">
                    <div class="row g-0 justify-content-between fs--1 mt-4 mb-3">
                        <div class="col-12 col-sm-auto text-center">
                            <p class="mb-0 text-600">
                                @appName &copy; @DateTime.Now.Year
                                <span class="d-none d-sm-inline-block"> | Your Company Name</span>
                            </p>
                        </div>
                    </div>
                </footer>

            </div>
        </div>
    </main>

    <script src="~/vendors/popper/popper.min.js"></script>
    <script src="~/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/vendors/is/is.min.js"></script>
    <script src="~/vendors/echarts/echarts.min.js"></script>
    <script src="~/vendors/fontawesome/all.min.js"></script>
    <script src="~/vendors/lodash/lodash.min.js"></script>
    <script src="~/vendors/list.js/list.min.js"></script>
    <script src="~/assets/js/theme.js"></script>
    <script src="/js/app-push.js?v=1"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
