@* src/BaseTemplate.Web/Views/Organization/Index.cshtml *@
@model BaseTemplate.Web.Models.OrganizationViewModel
@{
    ViewData["Title"]        = "Organization";
    ViewData["PageTitle"]    = "Organization";
    ViewData["PageSubTitle"] = "Commission organizational profile";
    ViewData["ActivePage"]   = "Organization";
    ViewData["ActiveGroup"]  = "Setup";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.HasOrganization)
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <div class="mb-4">
                <i class="fas fa-building fa-4x text-muted opacity-50"></i>
            </div>
            <h5 class="text-muted mb-2">No Organization Set Up</h5>
            <p class="text-muted mb-4">Create your organization profile to get started.</p>
            <a asp-action="Create" class="btn btn-primary px-4">
                <i class="fas fa-plus me-2"></i>Create Organization
            </a>
        </div>
    </div>
}
else
{
    @* ── Header banner with logo ─────────────────────────────────────────── *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <img src="~/uploads/org-logos/@Model.Logo" alt="Logo"
                             class="rounded border" style="max-height:64px;max-width:120px;object-fit:contain;" />
                    }
                    else
                    {
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;">
                            <i class="fas fa-building text-primary fs-4"></i>
                        </div>
                    }
                    <div>
                        <h5 class="mb-0 fw-semibold">@Model.Name</h5>
                        @if (!string.IsNullOrEmpty(Model.ShortName))
                        {
                            <span class="badge bg-primary bg-opacity-15 text-primary">@Model.ShortName</span>
                        }
                    </div>
                </div>
                <a asp-action="Edit" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm">
                    <i class="fas fa-pencil-alt me-1"></i>Edit
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">

        @* ── Basic Info ─────────────────────────────────────────────────── *@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 fs--1">
                        <dt class="col-sm-5 text-muted fw-normal">Industry</dt>
                        <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Industry) ? "—" : Model.Industry)</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Established</dt>
                        <dd class="col-sm-7">@(Model.EstablishedDate.HasValue ? Model.EstablishedDate.Value.ToString("dd MMM yyyy") : "—")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Reg. Number</dt>
                        <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.RegistrationNumber) ? "—" : Model.RegistrationNumber)</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Tax Number</dt>
                        <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.TaxNumber) ? "—" : Model.TaxNumber)</dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ── Contact ────────────────────────────────────────────────────── *@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fas fa-address-card me-2 text-primary"></i>Contact Details
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 fs--1">
                        <dt class="col-sm-4 text-muted fw-normal">Address</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</dd>
                        <dt class="col-sm-4 text-muted fw-normal">Phone</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</dd>
                        <dt class="col-sm-4 text-muted fw-normal">Email</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            }
                            else { <span>—</span> }
                        </dd>
                        <dt class="col-sm-4 text-muted fw-normal">Website</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Website))
                            {
                                <a href="@Model.Website" target="_blank" rel="noopener">@Model.Website</a>
                            }
                            else { <span>—</span> }
                        </dd>
                        <dt class="col-sm-4 text-muted fw-normal">Postal Code</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PostalCode) ? "—" : Model.PostalCode)</dd>
                        <dt class="col-sm-4 text-muted fw-normal">Google Code</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.GoogleCode))
                            {
                                <a href="https://maps.google.com/?q=@Uri.EscapeDataString(Model.GoogleCode)"
                                   target="_blank" rel="noopener">
                                    @Model.GoogleCode <i class="fas fa-external-link-alt fa-xs ms-1"></i>
                                </a>
                            }
                            else { <span>—</span> }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ── Mission ────────────────────────────────────────────────────── *@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-primary border-3">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-bullseye me-2"></i>Mission Statement
                    </h6>
                </div>
                <div class="card-body fs--1">
                    @if (!string.IsNullOrEmpty(Model.MissionStatement))
                    {
                        <p class="mb-0 fst-italic">@Model.MissionStatement</p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted fst-italic">Not yet defined. <a asp-action="Edit" asp-route-id="@Model.EncryptedId">Edit</a> to add.</p>
                    }
                </div>
            </div>
        </div>

        @* ── Vision ─────────────────────────────────────────────────────── *@
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-success border-3">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-semibold text-success">
                        <i class="fas fa-eye me-2"></i>Vision Statement
                    </h6>
                </div>
                <div class="card-body fs--1">
                    @if (!string.IsNullOrEmpty(Model.VisionStatement))
                    {
                        <p class="mb-0 fst-italic">@Model.VisionStatement</p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted fst-italic">Not yet defined. <a asp-action="Edit" asp-route-id="@Model.EncryptedId">Edit</a> to add.</p>
                    }
                </div>
            </div>
        </div>

    </div>
}
