@* src/BaseTemplate.Web/Views/Calendar/Create.cshtml *@
@model BaseTemplate.Web.Models.CalendarFormModel
@{
    ViewData["Title"] = "Add Calendar Month";
}

<div class="row g-3 justify-content-center">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header bg-light">
        <h5 class="mb-0"><span class="fas fa-calendar-plus me-2 text-primary"></span>Add Calendar Month</h5>
      </div>
      <div class="card-body">

        @if (!ViewData.ModelState.IsValid)
        {
          <div class="alert alert-danger">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
          </div>
        }

        <form asp-action="Create" method="post">
          @Html.AntiForgeryToken()

          <div class="row g-3">
            <div class="col-md-6">
              <label asp-for="Year" class="form-label fw-medium fs--1"></label>
              <input asp-for="Year" type="number" class="form-control form-control-sm"
                     min="2000" max="2099" />
              <span asp-validation-for="Year" class="text-danger fs--2"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="Month" class="form-label fw-medium fs--1">Month</label>
              <select asp-for="Month" class="form-select form-select-sm">
                <option value="">— Select Month —</option>
                @for (int m = 1; m <= 12; m++)
                {
                  <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                }
              </select>
              <span asp-validation-for="Month" class="text-danger fs--2"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="WorkingDays" class="form-label fw-medium fs--1"></label>
              <input asp-for="WorkingDays" type="number" class="form-control form-control-sm"
                     min="1" max="31" />
              <span asp-validation-for="WorkingDays" class="text-danger fs--2"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="WorkingHours" class="form-label fw-medium fs--1"></label>
              <input asp-for="WorkingHours" type="number" class="form-control form-control-sm"
                     min="1" max="248" />
              <span asp-validation-for="WorkingHours" class="text-danger fs--2"></span>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-falcon-default btn-sm">Cancel</a>
            <button type="submit" class="btn btn-falcon-primary btn-sm">
              <span class="fas fa-save me-1"></span>Save
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
