@* Views/PublicHoliday/_HolidayForm.cshtml *@
@model BaseTemplate.Web.Models.PublicHolidayFormModel

@if (!string.IsNullOrEmpty(Model.EncryptedId))
{
    <input type="hidden" name="EncryptedId" value="@Model.EncryptedId" />
}

<div class="row g-3">
    <div class="col-12">
        <label class="form-label fw-medium fs--1">Holiday Name <span class="text-danger">*</span></label>
        <input type="text" name="Name" value="@Model.Name" class="form-control form-control-sm"
               placeholder="e.g. Independence Day" required />
    </div>
    <div class="col-sm-6">
        <label class="form-label fw-medium fs--1">Date <span class="text-danger">*</span></label>
        <input type="date" name="Date" value="@Model.Date" class="form-control form-control-sm" required />
    </div>
    <div class="col-sm-6">
        <label class="form-label fw-medium fs--1">Type <span class="text-danger">*</span></label>
        <select name="HolidayType" class="form-select form-select-sm">
            @if (Model.HolidayType == 0)
            {
                <option value="0" selected>National</option>
            }
            else
            {
                <option value="0">National</option>
            }
            @if (Model.HolidayType == 1)
            {
                <option value="1" selected>Local</option>
            }
            else
            {
                <option value="1">Local</option>
            }
        </select>
    </div>
    <div class="col-12">
        <label class="form-label fw-medium fs--1">Description</label>
        <input type="text" name="Description" value="@Model.Description" class="form-control form-control-sm"
               placeholder="Optional details" />
    </div>
    <div class="col-12">
        <div class="d-flex gap-4">
            <div class="form-check">
                @if (Model.IsRecurring)
                {
                    <input class="form-check-input" type="checkbox" name="IsRecurring" id="isRecurring"
                           value="true" checked />
                }
                else
                {
                    <input class="form-check-input" type="checkbox" name="IsRecurring" id="isRecurring"
                           value="true" />
                }
                <label class="form-check-label fs--1" for="isRecurring">Recurring (repeats every year)</label>
            </div>
            <div class="form-check">
                @if (Model.IsActive)
                {
                    <input class="form-check-input" type="checkbox" name="IsActive" id="isActive"
                           value="true" checked />
                }
                else
                {
                    <input class="form-check-input" type="checkbox" name="IsActive" id="isActive"
                           value="true" />
                }
                <label class="form-check-label fs--1" for="isActive">Active</label>
            </div>
        </div>
    </div>
</div>
