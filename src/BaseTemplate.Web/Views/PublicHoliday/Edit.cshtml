@* Views/PublicHoliday/Edit.cshtml *@
@model BaseTemplate.Web.Models.PublicHolidayFormModel
@{
    ViewData["Title"]        = "Edit Holiday";
    ViewData["PageTitle"]    = "Attendance Setup";
    ViewData["PageSubTitle"] = "Edit Public Holiday";
}

<div class="card shadow-sm border-0" style="max-width:560px;">
    <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-calendar-alt me-2 text-primary"></i>Edit Holiday</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_HolidayForm", Model)
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-save me-1"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>
