@* ── Branch/Index.cshtml ── *@
@model BaseTemplate.Web.Models.BranchListViewModel
@{
    ViewData["Title"] = "Branches";
    ViewData["PageTitle"] = "Branches";
    ViewData["PageSubTitle"] = "Manage office branches";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-code-branch me-2 text-primary"></i>All Branches</h6>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add Branch
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Branches.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-code-branch fa-3x mb-3 opacity-25"></i>
                <p class="mb-0">No branches found. <a asp-action="Create">Add your first branch</a>.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 fs--1">
                    <thead class="bg-200">
                        <tr>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Location</th>
                            <th class="text-center">Head Office</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Branches)
                        {
                            <tr>
                                <td class="fw-medium">@b.Name</td>
                                <td><span class="badge badge-subtle-secondary">@b.Code</span></td>
                                <td class="text-muted">@b.Location</td>
                                <td class="text-center">
                                    @if (b.IsHeadOffice)
                                    {
                                        <span class="badge badge-subtle-warning"><i class="fas fa-star me-1"></i>HQ</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (b.IsActive)
                                    {
                                        <span class="badge badge-subtle-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-subtle-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@b.EncryptedId"
                                       class="btn btn-falcon-default btn-sm py-0 px-2">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@b.EncryptedId"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-falcon-danger btn-sm py-0 px-2">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
