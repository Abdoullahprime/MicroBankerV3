@* src/Microbanker.Web/Views/Shared/_ProfileFields.cshtml
   Form body shared by Customer and SelfRegistration. Set ViewData["TypeLocked"] = true on edit. *@
@model Microbanker.Web.Models.ProfileFormModel
@{
    var typeLocked = ViewData["TypeLocked"] as bool? == true;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs--1"></div>

@* ── Basics ── *@
<h6 class="fw-semibold text-700 mb-3"><i class="fas fa-id-card me-2 text-primary"></i>Basics</h6>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="BranchId" class="form-label fw-medium"></label> <span class="text-danger">*</span>
        <select asp-for="BranchId" asp-items="Model.Branches" class="form-select">
            <option value="">— Select branch —</option>
        </select>
        <span asp-validation-for="BranchId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CustomerType" class="form-label fw-medium"></label> <span class="text-danger">*</span>
        @if (typeLocked)
        {
            <input type="hidden" asp-for="CustomerType" />
            <select id="CustomerTypeDisplay" class="form-select" disabled>
                <option value="@Model.CustomerType" selected>@Model.CustomerType</option>
            </select>
            <div class="form-text">The customer type cannot be changed after creation.</div>
        }
        else
        {
            <select asp-for="CustomerType" asp-items="Model.CustomerTypes" class="form-select"></select>
        }
        <span asp-validation-for="CustomerType" class="text-danger small"></span>
    </div>
</div>

@* ── Individual ── *@
