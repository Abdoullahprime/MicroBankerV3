            <select asp-for="Prefix" asp-items="Model.Prefixes" class="form-select"><option value="">—</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="FirstName" class="form-label fw-medium"></label> <span class="text-danger">*</span>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="MiddleName" class="form-label fw-medium"></label>
            <input asp-for="MiddleName" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="LastName" class="form-label fw-medium"></label> <span class="text-danger">*</span>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DateOfBirth" class="form-label fw-medium"></label>
            <input asp-for="DateOfBirth" class="form-control" type="date" />
            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Sex" class="form-label fw-medium"></label>
            <select asp-for="Sex" asp-items="Model.Sexes" class="form-select"><option value="">—</option></select>
        </div>
        <div class="col-md-3">
            <label asp-for="MaritalStatus" class="form-label fw-medium"></label>
            <select asp-for="MaritalStatus" asp-items="Model.MaritalStatuses" class="form-select"><option value="">—</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="SpouseName" class="form-label fw-medium"></label>
            <input asp-for="SpouseName" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Dependants" class="form-label fw-medium"></label>
            <input asp-for="Dependants" class="form-control" type="number" min="0" step="1" />
            <span asp-validation-for="Dependants" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Nationality" class="form-label fw-medium"></label>
            <input asp-for="Nationality" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="ResidenceStatus" class="form-label fw-medium"></label>
            <select asp-for="ResidenceStatus" asp-items="Model.ResidenceStatuses" class="form-select"><option value="">—</option></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Language" class="form-label fw-medium"></label>
            <input asp-for="Language" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Occupation" class="form-label fw-medium"></label>
            <input asp-for="Occupation" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="EmployerName" class="form-label fw-medium"></label>
            <input asp-for="EmployerName" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="NationalId" class="form-label fw-medium"></label>
            <input asp-for="NationalId" class="form-control" />
            <span asp-validation-for="NationalId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PassportNo" class="form-label fw-medium"></label>
            <input asp-for="PassportNo" class="form-control" />
        </div>
    </div>
</div>

