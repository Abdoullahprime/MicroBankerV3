@* ── Location & classification ── *@
<h6 class="fw-semibold text-700 mb-3"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Location &amp; Classification</h6>
<div class="row g-3 mb-2">
    <div class="col-md-4">
        <label asp-for="RegionId" class="form-label fw-medium"></label>
        <select asp-for="RegionId" asp-items="Model.Regions" class="form-select"><option value="">— Select —</option></select>
        <span asp-validation-for="RegionId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DistrictId" class="form-label fw-medium"></label>
        <select asp-for="DistrictId" class="form-select" data-parent="RegionId">
            <option value="">— Select —</option>
            @foreach (var d in Model.Districts) { <option value="@d.Id" data-parent-id="@d.ParentId">@d.Name</option> }
        </select>
        <span asp-validation-for="DistrictId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="AreaId" class="form-label fw-medium"></label>
        <select asp-for="AreaId" class="form-select" data-parent="DistrictId">
            <option value="">— Select —</option>
            @foreach (var a in Model.Areas) { <option value="@a.Id" data-parent-id="@a.ParentId">@a.Name</option> }
        </select>
        <span asp-validation-for="AreaId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SectorId" class="form-label fw-medium"></label>
        <select asp-for="SectorId" asp-items="Model.Sectors" class="form-select"><option value="">— Select —</option></select>
        <span asp-validation-for="SectorId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SubSectorId" class="form-label fw-medium"></label>
        <select asp-for="SubSectorId" class="form-select" data-parent="SectorId">
            <option value="">— Select —</option>
            @foreach (var s in Model.SubSectors) { <option value="@s.Id" data-parent-id="@s.ParentId">@s.Name</option> }
        </select>
        <span asp-validation-for="SubSectorId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TinNo" class="form-label fw-medium"></label>
        <input asp-for="TinNo" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="RelationshipOfficer" class="form-label fw-medium"></label>
        <input asp-for="RelationshipOfficer" class="form-control" />
    </div>
</div>

<script>
    (function () {
        // Show only the section for the chosen customer type.
        var typeEl = document.getElementById('CustomerType');
        function applyType() {
            var t = typeEl.value;
            document.querySelectorAll('[data-types]').forEach(function (s) {
                s.classList.toggle('d-none', s.getAttribute('data-types').split(' ').indexOf(t) === -1);
            });
        }
        typeEl.addEventListener('change', applyType);
        applyType();

        // Child dropdowns (district, area, sub-sector) list only the options under the chosen parent.
        document.querySelectorAll('select[data-parent]').forEach(function (child) {
            var parent = document.getElementById(child.getAttribute('data-parent'));
            function filter() {
                var pv = parent.value;
                Array.prototype.forEach.call(child.options, function (o) {
                    if (!o.value) return;
                    var show = pv !== '' && o.getAttribute('data-parent-id') === pv;
                    o.hidden = !show;
                    o.disabled = !show;
                });
                var sel = child.options[child.selectedIndex];
                if (sel && sel.disabled) child.value = '';
                child.dispatchEvent(new Event('change'));
            }
            parent.addEventListener('change', filter);
            filter();
        });
    })();
</script>
