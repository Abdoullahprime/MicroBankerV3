@* src/Microbanker.Web/Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html data-bs-theme="light" lang="en-US" dir="ltr">

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] - Matrix Microbanker V3</title>

  <link rel="apple-touch-icon" sizes="180x180" href="~/assets/img/favicons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="~/assets/img/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="~/assets/img/favicons/favicon-16x16.png">
  <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicons/favicon.ico">
  <link rel="manifest" href="~/assets/img/favicons/manifest.json">
  <meta name="msapplication-TileImage" content="~/assets/img/favicons/mstile-150x150.png">
  <meta name="theme-color" content="#ffffff">

  <script src="~/assets/js/config.js"></script>
  <script src="~/vendors/simplebar/simplebar.min.js"></script>

  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800,900&amp;display=swap" rel="stylesheet">
  <link href="~/vendors/simplebar/simplebar.min.css" rel="stylesheet">
  <link href="~/assets/css/theme-rtl.css" rel="stylesheet" id="style-rtl">
  <link href="~/assets/css/theme.css" rel="stylesheet" id="style-default">
  <link href="~/assets/css/user-rtl.css" rel="stylesheet" id="user-style-rtl">
  <link href="~/assets/css/user.css" rel="stylesheet" id="user-style-default">

  <script>
    var isRTL = JSON.parse(localStorage.getItem('isRTL'));
    if (isRTL) {
      var linkDefault = document.getElementById('style-default');
      var userLinkDefault = document.getElementById('user-style-default');
      linkDefault.setAttribute('disabled', true);
      userLinkDefault.setAttribute('disabled', true);
      document.querySelector('html').setAttribute('dir', 'rtl');
    } else {
      var linkRTL = document.getElementById('style-rtl');
      var userLinkRTL = document.getElementById('user-style-rtl');
      linkRTL.setAttribute('disabled', true);
      userLinkRTL.setAttribute('disabled', true);
    }
  </script>

  @await RenderSectionAsync("Styles", required: false)
</head>

<body>
  <main class="main" id="top">
    <div class="container" data-layout="container">

      <script>
        var isFluid = JSON.parse(localStorage.getItem('isFluid'));
        if (isFluid) {
          var container = document.querySelector('[data-layout]');
          container.classList.remove('container');
          container.classList.add('container-fluid');
        }
      </script>

      <!-- ============================================================
           VERTICAL SIDEBAR — card style
           ============================================================ -->
      <nav class="navbar navbar-light navbar-vertical navbar-expand-xl navbar-card">
        <script>
          document.querySelector('.navbar-vertical').classList.add('navbar-card');
        </script>

        <div class="d-flex align-items-center">
          <div class="toggle-icon-wrapper">
            <button class="btn navbar-toggler-humburger-icon navbar-vertical-toggle"
                    data-bs-toggle="tooltip" data-bs-placement="left" title="Toggle Navigation">
              <span class="navbar-toggle-icon"><span class="toggle-line"></span></span>
            </button>
          </div>
          <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <div class="d-flex align-items-center py-3">
              <img class="me-2" src="~/assets/img/icons/spot-illustrations/falcon.png" alt="" width="40" />
              <span class="font-sans-serif text-primary fw-bold">MicrobankerV3</span>
            </div>
          </a>
        </div>

        <div class="collapse navbar-collapse" id="navbarVerticalCollapse">
          <div class="navbar-vertical-content scrollbar">
            <ul class="navbar-nav flex-column mb-3" id="navbarVerticalNav">

              <!-- ── DASHBOARD ──────────────────────────────────── -->
              <li class="nav-item">
                <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" role="button">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-tachometer-alt"></span></span>
                    <span class="nav-link-text ps-1">Dashboard</span>
                  </div>
                </a>
              </li>

              <!-- ════════════════════ MAINTENANCE ════════════════════ -->
              <li class="nav-item">
                <div class="row navbar-vertical-label-wrapper mt-3 mb-2">
                  <div class="col-auto navbar-vertical-label">Maintenance</div>
                  <div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div>
                </div>

                <a class="nav-link dropdown-indicator"
                   href="#nav-org" role="button" data-bs-toggle="collapse"
                   aria-expanded="@(ViewData["ActiveGroup"]?.ToString() == "Org" ? "true" : "false")"
                   aria-controls="nav-org">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-sitemap"></span></span>
                    <span class="nav-link-text ps-1">Organisation</span>
                  </div>
                </a>
                <ul class="nav collapse @(ViewData["ActiveGroup"]?.ToString() == "Org" ? "show" : "")"
                    id="nav-org">
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Organization" ? "active" : "")"
                       asp-controller="Organization" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Organization</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Branches" ? "active" : "")"
                       asp-controller="Branch" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Branches</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Departments" ? "active" : "")"
                       asp-controller="Department" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Departments</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Units" ? "active" : "")"
                       asp-controller="Unit" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Units</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Banks" ? "active" : "")"
                       asp-controller="Bank" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Banks</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </li>

              <!-- ════════════════════ SETUP ════════════════════ -->
              <li class="nav-item">
                <a class="nav-link dropdown-indicator"
                   href="#nav-setup" role="button" data-bs-toggle="collapse"
                   aria-expanded="@(ViewData["ActiveGroup"]?.ToString() == "Setup" ? "true" : "false")"
                   aria-controls="nav-setup">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-cogs"></span></span>
                    <span class="nav-link-text ps-1">Setup</span>
                  </div>
                </a>
                <ul class="nav collapse @(ViewData["ActiveGroup"]?.ToString() == "Setup" ? "show" : "")"
                    id="nav-setup">
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Regions" ? "active" : "")"
                       asp-controller="Region" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Regions</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Districts" ? "active" : "")"
                       asp-controller="District" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Districts</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Areas" ? "active" : "")"
                       asp-controller="Area" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Areas</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Sectors" ? "active" : "")"
                       asp-controller="Sector" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Sectors</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "SubSectors" ? "active" : "")"
                       asp-controller="SubSector" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Sub-Sectors</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "ProductTypes" ? "active" : "")"
                       asp-controller="ProductType" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Product Types</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "ProductDefinitions" ? "active" : "")"
                       asp-controller="ProductDefinition" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Product Definitions</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "TransactionCodes" ? "active" : "")"
                       asp-controller="TransactionCode" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Transaction Codes</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "ChartOfAccounts" ? "active" : "")"
                       asp-controller="ChartOfAccounts" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Chart of Accounts</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </li>

              <!-- ════════════════════ BANKING ════════════════════ -->
              <li class="nav-item">
                <div class="row navbar-vertical-label-wrapper mt-3 mb-2">
                  <div class="col-auto navbar-vertical-label">Banking</div>
                  <div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div>
                </div>

                <a class="nav-link dropdown-indicator"
                   href="#nav-banking" role="button" data-bs-toggle="collapse"
                   aria-expanded="@(ViewData["ActiveGroup"]?.ToString() == "Banking" ? "true" : "false")"
                   aria-controls="nav-banking">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-landmark"></span></span>
                    <span class="nav-link-text ps-1">Banking</span>
                  </div>
                </a>
                <ul class="nav collapse @(ViewData["ActiveGroup"]?.ToString() == "Banking" ? "show" : "")"
                    id="nav-banking">
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Customers" ? "active" : "")"
                       asp-controller="Customer" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Customers</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "SelfReg" ? "active" : "")"
                       asp-controller="SelfRegistration" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Self Registration</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Accounts" ? "active" : "")"
                       asp-controller="Account" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Accounts</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "BalanceEnquiry" ? "active" : "")"
                       asp-controller="Account" asp-action="BalanceEnquiry">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Balance Enquiry</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </li>

              <!-- ════════════════════ LENDING ════════════════════ -->
              <li class="nav-item">
                <div class="row navbar-vertical-label-wrapper mt-3 mb-2">
                  <div class="col-auto navbar-vertical-label">Lending</div>
                  <div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div>
                </div>

                <a class="nav-link dropdown-indicator"
                   href="#nav-lending" role="button" data-bs-toggle="collapse"
                   aria-expanded="@(ViewData["ActiveGroup"]?.ToString() == "Lending" ? "true" : "false")"
                   aria-controls="nav-lending">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-hand-holding-usd"></span></span>
                    <span class="nav-link-text ps-1">Lending</span>
                  </div>
                </a>
                <ul class="nav collapse @(ViewData["ActiveGroup"]?.ToString() == "Lending" ? "show" : "")"
                    id="nav-lending">
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Loans" ? "active" : "")"
                       asp-controller="Loan" asp-action="Index">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Loans</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "LoanRequests" ? "active" : "")"
                       asp-controller="Loan" asp-action="Requests">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Loan Requests</span>
                      </div>
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "LoanEnquiry" ? "active" : "")"
                       asp-controller="Loan" asp-action="BalanceEnquiry">
                      <div class="d-flex align-items-center">
                        <span class="nav-link-text ps-1">Loan Enquiry</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </li>

              <!-- ════════════════════ ADMINISTRATION ════════════════════ -->
              <li class="nav-item">
                <div class="row navbar-vertical-label-wrapper mt-3 mb-2">
                  <div class="col-auto navbar-vertical-label">Administration</div>
                  <div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div>
                </div>

                <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")"
                   asp-controller="Users" asp-action="Index" role="button">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-user-cog"></span></span>
                    <span class="nav-link-text ps-1">Users</span>
                  </div>
                </a>

                <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Roles" ? "active" : "")"
                   asp-controller="Roles" asp-action="Index" role="button">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-shield-alt"></span></span>
                    <span class="nav-link-text ps-1">Roles</span>
                  </div>
                </a>

                <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Permissions" ? "active" : "")"
                   asp-controller="Permissions" asp-action="Index" role="button">
                  <div class="d-flex align-items-center">
                    <span class="nav-link-icon"><span class="fas fa-key"></span></span>
                    <span class="nav-link-text ps-1">Permissions</span>
                  </div>
                </a>
              </li>

            </ul>
          </div>
        </div>
      </nav>

      <!-- ============================================================
           CONTENT WRAPPER
           ============================================================ -->
      <div class="content">

        <!-- TOP NAVBAR -->
        <nav class="navbar navbar-light navbar-glass navbar-top navbar-expand">

          <button class="btn navbar-toggler-humburger-icon navbar-toggler me-1 me-sm-3"
                  type="button" data-bs-toggle="collapse"
                  data-bs-target="#navbarVerticalCollapse"
                  aria-controls="navbarVerticalCollapse"
                  aria-expanded="false" aria-label="Toggle Navigation">
            <span class="navbar-toggle-icon"><span class="toggle-line"></span></span>
          </button>

          <a class="navbar-brand me-1 me-sm-3" asp-controller="Home" asp-action="Index">
            <div class="d-flex align-items-center">
              <img class="me-2" src="~/assets/img/icons/spot-illustrations/falcon.png" alt="" width="40" />
              <span class="font-sans-serif text-primary fw-bold">MicrobankerV3</span>
            </div>
          </a>

          <ul class="navbar-nav navbar-nav-icons ms-auto flex-row align-items-center">

            <!-- Theme switcher -->
            <li class="nav-item ps-2 pe-0">
              <div class="dropdown theme-control-dropdown">
                <a class="nav-link d-flex align-items-center dropdown-toggle fa-icon-wait fs-0 pe-1 py-0"
                   href="#" role="button" id="themeSwitchDropdown"
                   data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <span class="fas fa-sun fs-2" data-fa-transform="shrink-2" data-theme-dropdown-toggle-icon="light"></span>
                  <span class="fas fa-moon fs-2" data-fa-transform="shrink-3" data-theme-dropdown-toggle-icon="dark"></span>
                  <span class="fas fa-adjust fs-2" data-fa-transform="shrink-2" data-theme-dropdown-toggle-icon="auto"></span>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-caret border py-0 mt-3"
                     aria-labelledby="themeSwitchDropdown">
                  <div class="bg-white dark__bg-1000 rounded-2 py-2">
                    <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                            value="light" data-theme-control="theme">
                      <span class="fas fa-sun"></span>Light
                      <span class="fas fa-check dropdown-check-icon ms-auto text-600"></span>
                    </button>
                    <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                            value="dark" data-theme-control="theme">
                      <span class="fas fa-moon"></span>Dark
                      <span class="fas fa-check dropdown-check-icon ms-auto text-600"></span>
                    </button>
                    <button class="dropdown-item d-flex align-items-center gap-2" type="button"
                            value="auto" data-theme-control="theme">
                      <span class="fas fa-adjust"></span>Auto
                      <span class="fas fa-check dropdown-check-icon ms-auto text-600"></span>
                    </button>
                  </div>
                </div>
              </div>
            </li>

            <!-- Notifications -->
            <li class="nav-item dropdown">
              <a class="nav-link notification-indicator notification-indicator-primary px-0 fa-icon-wait"
                 id="navbarDropdownNotification" role="button"
                 data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                 data-hide-on-body-scroll="data-hide-on-body-scroll">
                <span class="fas fa-bell" data-fa-transform="shrink-6" style="font-size:33px;"></span>
              </a>
              <div class="dropdown-menu dropdown-caret dropdown-menu-end dropdown-menu-card dropdown-menu-notification dropdown-caret-bg"
                   aria-labelledby="navbarDropdownNotification">
                <div class="card card-notification shadow-none">
                  <div class="card-header">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-auto">
                        <h6 class="card-header-title mb-0">Notifications</h6>
                      </div>
                      <div class="col-auto ps-0 ps-sm-3">
                        <a class="card-link fw-normal" href="#">Mark all as read</a>
                      </div>
                    </div>
                  </div>
                  <div class="scrollbar-overlay" style="max-height:19rem">
                    <div class="list-group list-group-flush fw-normal fs--1">
                      <div class="list-group-title border-bottom">SYSTEM</div>
                      <div class="list-group-item">
                        <a class="notification notification-flush notification-unread" href="#!">
                          <div class="notification-avatar">
                            <div class="avatar avatar-2xl me-3">
                              <div class="avatar-name rounded-circle bg-primary-subtle text-primary">
                                <span>H</span>
                              </div>
                            </div>
                          </div>
                          <div class="notification-body">
                            <p class="mb-1"><strong>Matrix Microbanker</strong> — session active.</p>
                            <span class="notification-time">Just now</span>
                          </div>
                        </a>
                      </div>
                    </div>
                  </div>
                  <div class="card-footer text-center border-top">
                    <a class="card-link d-block" href="#">View all</a>
                  </div>
                </div>
              </div>
            </li>

            <!-- User dropdown -->
            <li class="nav-item dropdown">
              <a class="nav-link pe-0 ps-2" id="navbarDropdownUser" role="button"
                 data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <div class="avatar avatar-xl">
                  <img class="rounded-circle" src="~/assets/img/team/3-thumb.png" alt="" />
                </div>
              </a>
              <div class="dropdown-menu dropdown-caret dropdown-menu-end py-0"
                   aria-labelledby="navbarDropdownUser">
                <div class="bg-white dark__bg-1000 rounded-2 py-2">
                  <div class="px-3 pt-2 pb-2 border-bottom">
                    <p class="fw-bold mb-0 text-800 fs--1">@ViewData["UserName"]</p>
                    <p class="fs--2 text-500 mb-0">@ViewData["UserCompany"]</p>
                    <span class="badge badge-subtle-success fs--2 mt-1">
                      <span class="fas fa-shield-alt me-1"></span>Via MOS
                    </span>
                  </div>
                  <div class="dropdown-divider"></div>
                  <a class="dropdown-item fs--1 py-2 text-danger"
                     asp-controller="Auth" asp-action="Logout">
                    <span class="fas fa-sign-out-alt me-2"></span>Logout
                  </a>
                </div>
              </div>
            </li>

          </ul>
        </nav>
        <!-- /TOP NAVBAR -->

        @RenderBody()

        <footer class="footer">
          <div class="row g-0 justify-content-between fs--1 mt-4 mb-3">
            <div class="col-12 col-sm-auto text-center">
              <p class="mb-0 text-600">
                Matrix Microbanker &copy; @DateTime.Now.Year
                <span class="d-none d-sm-inline-block"> | Matrix Solutions Company Limited</span>
              </p>
            </div>
          </div>
        </footer>

      </div>
    </div>
  </main>

  <script src="~/vendors/popper/popper.min.js"></script>
  <script src="~/vendors/bootstrap/bootstrap.min.js"></script>
  <script src="~/vendors/anchorjs/anchor.min.js"></script>
  <script src="~/vendors/is/is.min.js"></script>
  <script src="~/vendors/echarts/echarts.min.js"></script>
  <script src="~/vendors/fontawesome/all.min.js"></script>
  <script src="~/vendors/lodash/lodash.min.js"></script>
  <script src="~/vendors/list.js/list.min.js"></script>
  <script src="~/assets/js/theme.js"></script>

  @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
