@* ── Department/Create.cshtml ── *@
@model Microbanker.Web.Models.DepartmentFormModel
@{
    ViewData["Title"] = "Add Department";
    ViewData["PageTitle"] = "Add Department";
    ViewData["PageSubTitle"] = "Create a new department";
}

<div class="card shadow-sm border-0" style="max-width:600px;">
    <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-sitemap me-2 text-primary"></i>Department Details</h6>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="EncryptedBranchId" class="form-label fw-medium">Branch</label>
                    <select asp-for="EncryptedBranchId" asp-items="Model.BranchOptions"
                            class="form-select">
                        <option value="">-- Select Branch --</option>
                    </select>
                    <span asp-validation-for="EncryptedBranchId" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-medium"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Information Technology" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label fw-medium"></label>
                    <input asp-for="Code" class="form-control" placeholder="e.g. IT" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-medium"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Department
                </button>
                <a asp-action="Index" class="btn btn-falcon-default">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
