@* src/Microbanker.Web/Views/ProductDefinition/Edit.cshtml *@
@model Microbanker.Web.Models.ProductDefinitionFormModel
@{
    ViewData["Title"]        = "Edit Product Definition";
    ViewData["PageTitle"]    = "Edit Product Definition";
    ViewData["PageSubTitle"] = "Update product definition details";
}

<div class="card shadow-sm border-0" style="max-width:720px;">
    <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-box-open me-2 text-primary"></i>Product Definition Details</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.EncryptedId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs--1"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ProductTypeId" class="form-label fw-medium"></label>
                    <select asp-for="ProductTypeId" asp-items="Model.ProductTypes" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                    <span asp-validation-for="ProductTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label fw-medium"></label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Name" class="form-label fw-medium"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MinBalance" class="form-label fw-medium"></label>
                    <input asp-for="MinBalance" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="MinBalance" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="InterestRate" class="form-label fw-medium"></label>
                    <input asp-for="InterestRate" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="InterestRate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="InterestCalcMethod" class="form-label fw-medium"></label>
                    <select asp-for="InterestCalcMethod" asp-items="Model.CalcMethods" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                    <span asp-validation-for="InterestCalcMethod" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="InterestFrequency" class="form-label fw-medium"></label>
                    <input asp-for="InterestFrequency" class="form-control" type="number" step="1" min="0" />
                    <span asp-validation-for="InterestFrequency" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DormancyDays" class="form-label fw-medium"></label>
                    <input asp-for="DormancyDays" class="form-control" type="number" step="1" min="0" />
                    <span asp-validation-for="DormancyDays" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxDebitPerMonth" class="form-label fw-medium"></label>
                    <input asp-for="MaxDebitPerMonth" class="form-control" type="number" step="1" min="0" />
                    <span asp-validation-for="MaxDebitPerMonth" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-medium"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Update Product Definition
                </button>
                <a asp-action="Index" class="btn btn-falcon-default">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
