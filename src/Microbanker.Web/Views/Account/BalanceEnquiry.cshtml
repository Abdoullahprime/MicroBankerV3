@* src/Microbanker.Web/Views/Account/BalanceEnquiry.cshtml *@
@model Microbanker.Web.Models.BalanceEnquiryViewModel
@{
    ViewData["Title"]        = "Balance Enquiry";
    ViewData["PageTitle"]    = "Balance Enquiry";
    ViewData["PageSubTitle"] = "Look up an account by number";
}
@functions {
    static string Badge(string status) => status switch
    {
        "ACTIVE" or "APPROVED"            => "badge-subtle-success",
        "PENDING"                         => "badge-subtle-warning",
        "FROZEN" or "REJECTED"            => "badge-subtle-danger",
        "DORMANT"                         => "badge-subtle-info",
        _                                 => "badge-subtle-secondary"
    };
}

<div class="card shadow-sm border-0 mb-3" style="max-width:640px;">
    <div class="card-body">
        <form method="get" class="d-flex gap-2">
            <input name="accountNo" value="@Model.AccountNo" class="form-control" placeholder="Account number, e.g. HO-SA-0000001" autofocus />
            <button class="btn btn-primary" type="submit"><i class="fas fa-search me-1"></i>Search</button>
        </form>
    </div>
</div>

@if (Model.Searched && Model.Account == null)
{
    <div class="alert alert-warning fs--1" style="max-width:640px;"><i class="fas fa-exclamation-triangle me-2"></i>No account found with number <strong>@Model.AccountNo</strong>.</div>
}
else if (Model.Account != null)
{
    var a = Model.Account;
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">@a.AccountName <span class="badge @Badge(a.Status) ms-2">@a.Status</span></h5>
                <div class="fs--1 text-muted">@a.AccountNo · @a.AccountType.Replace("_", " ") · @a.ProductName · @a.BranchName · @a.CustomerNo @a.CustomerName</div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="View" asp-route-id="@a.EncryptedId" class="btn btn-falcon-default btn-sm">Full details</a>
                <a asp-action="MiniStatement" asp-route-id="@a.EncryptedId" class="btn btn-falcon-default btn-sm">Mini statement</a>
            </div>
        </div>
    </div>
    <partial name="_Balances" model="a" />
}
