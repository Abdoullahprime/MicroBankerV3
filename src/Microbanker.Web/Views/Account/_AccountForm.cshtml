@* src/Microbanker.Web/Views/Account/_AccountForm.cshtml — shared by Create and Edit *@
@model Microbanker.Web.Models.AccountFormModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs--1"></div>

<h6 class="fw-semibold text-700 mb-3"><i class="fas fa-piggy-bank me-2 text-primary"></i>Account</h6>
<div class="row g-3 mb-4">
    @if (Model.IsEdit)
    {
        <div class="col-md-4">
            <label class="form-label fw-medium">Account No.</label>
            <input class="form-control" value="@Model.AccountNo" disabled />
        </div>
        <div class="col-md-8">
            <label class="form-label fw-medium">Customer</label>
            <input class="form-control" value="@Model.CustomerLabel" disabled />
        </div>
    }
    else
    {
        <div class="col-md-4">
            <label asp-for="CustomerNo" class="form-label fw-medium"></label> <span class="text-danger">*</span>
            <input asp-for="CustomerNo" class="form-control" placeholder="CUST-2026-000001" autocomplete="off" />
            <span asp-validation-for="CustomerNo" class="text-danger small"></span>
        </div>
        <div class="col-md-8">
            <label class="form-label fw-medium">Customer</label>
            <div id="customerPreview" class="form-control bg-200 text-muted">@(Model.CustomerName ?? "Type a customer number")</div>
        </div>
    }

    <div class="col-md-4">
        <label asp-for="AccountType" class="form-label fw-medium"></label>
        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="AccountType" />
            <input class="form-control" value="@Model.AccountType.Replace("_", " ")" disabled />
        }
        else
        {
            <select asp-for="AccountType" asp-items="Model.AccountTypes" class="form-select"></select>
        }
        <span asp-validation-for="AccountType" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="BranchId" class="form-label fw-medium"></label>
        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="BranchId" />
            <input class="form-control" value="@(Model.Branches.FirstOrDefault(b => b.Value == Model.BranchId.ToString())?.Text)" disabled />
        }
        else
        {
            <select asp-for="BranchId" asp-items="Model.Branches" class="form-select"><option value="">— Select branch —</option></select>
        }
        <span asp-validation-for="BranchId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="AccountName" class="form-label fw-medium"></label>
        <input asp-for="AccountName" class="form-control" placeholder="Defaults to the customer's name" />
        <span asp-validation-for="AccountName" class="text-danger small"></span>
    </div>
</div>

<h6 class="fw-semibold text-700 mb-3"><i class="fas fa-file-contract me-2 text-primary"></i>Terms</h6>
@if (!Model.TermsEditable)
{
    <div class="alert alert-light border fs--1 py-2"><i class="fas fa-lock me-2"></i>Product, currency, opening balance and open date are fixed once the account is approved.</div>
}
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="ProductDefinitionId" class="form-label fw-medium"></label>
        <select asp-for="ProductDefinitionId" asp-items="Model.Products" class="form-select" disabled="@(!Model.TermsEditable)"><option value="">— Select product —</option></select>
        <span asp-validation-for="ProductDefinitionId" class="text-danger small"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="Currency" class="form-label fw-medium"></label>
        <input asp-for="Currency" class="form-control text-uppercase" maxlength="3" readonly="@(!Model.TermsEditable)" />
        <span asp-validation-for="Currency" class="text-danger small"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="OpeningBalance" class="form-label fw-medium"></label>
        <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" min="0" readonly="@(!Model.TermsEditable)" />
        <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="OpenDate" class="form-label fw-medium"></label>
        <input asp-for="OpenDate" class="form-control" type="date" readonly="@(!Model.TermsEditable)" />
        <span asp-validation-for="OpenDate" class="text-danger small"></span>
    </div>
</div>

<h6 class="fw-semibold text-700 mb-3"><i class="fas fa-credit-card me-2 text-primary"></i>ATM &amp; Classification</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="AtmAccountNo" class="form-label fw-medium"></label>
        <input asp-for="AtmAccountNo" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="AtmDailyLimit" class="form-label fw-medium"></label>
        <input asp-for="AtmDailyLimit" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="AtmDailyLimit" class="text-danger small"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="SectorId" class="form-label fw-medium"></label>
        <select asp-for="SectorId" asp-items="Model.Sectors" class="form-select"><option value="">—</option></select>
    </div>
    <div class="col-md-2">
        <label asp-for="SubSectorId" class="form-label fw-medium"></label>
        <select asp-for="SubSectorId" class="form-select" data-parent="SectorId">
            <option value="">—</option>
            @foreach (var s in Model.SubSectors) { <option value="@s.Id" data-parent-id="@s.ParentId">@s.Name</option> }
        </select>
        <span asp-validation-for="SubSectorId" class="text-danger small"></span>
    </div>
</div>

<h6 class="fw-semibold text-700 mb-3"><i class="fas fa-book me-2 text-primary"></i>General Ledger Mapping</h6>
<div class="row g-3 mb-2">
        <div class="col-md-4">
            <label asp-for="GLLiabilityControl" class="form-label fw-medium"></label>
            <select asp-for="GLLiabilityControl" asp-items="Model.LiabilityGLs" class="form-select"><option value="">— None —</option></select>
            <span asp-validation-for="GLLiabilityControl" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GLAssetControl" class="form-label fw-medium"></label>
            <select asp-for="GLAssetControl" asp-items="Model.AssetGLs" class="form-select"><option value="">— None —</option></select>
            <span asp-validation-for="GLAssetControl" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GLIncomeAccount" class="form-label fw-medium"></label>
            <select asp-for="GLIncomeAccount" asp-items="Model.IncomeGLs" class="form-select"><option value="">— None —</option></select>
            <span asp-validation-for="GLIncomeAccount" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GLExpenseAccount" class="form-label fw-medium"></label>
            <select asp-for="GLExpenseAccount" asp-items="Model.ExpenseGLs" class="form-select"><option value="">— None —</option></select>
            <span asp-validation-for="GLExpenseAccount" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GLChargeAccount" class="form-label fw-medium"></label>
            <select asp-for="GLChargeAccount" asp-items="Model.IncomeGLs" class="form-select"><option value="">— None —</option></select>
            <span asp-validation-for="GLChargeAccount" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="GLFeeAccount" class="form-label fw-medium"></label>
            <select asp-for="GLFeeAccount" asp-items="Model.IncomeGLs" class="form-select"><option value="">— None —</option></select>
            <span asp-validation-for="GLFeeAccount" class="text-danger small"></span>
        </div>
</div>

<script>
    (function () {
        // Sub-sectors list only the options under the chosen sector.
        document.querySelectorAll('select[data-parent]').forEach(function (child) {
            var parent = document.getElementById(child.getAttribute('data-parent'));
            function filter() {
                var pv = parent.value;
                Array.prototype.forEach.call(child.options, function (o) {
                    if (!o.value) return;
                    var show = pv !== '' && o.getAttribute('data-parent-id') === pv;
                    o.hidden = !show; o.disabled = !show;
                });
                var sel = child.options[child.selectedIndex];
                if (sel && sel.disabled) child.value = '';
            }
            parent.addEventListener('change', filter);
            filter();
        });

        // Show who the typed customer number belongs to.
        var no = document.getElementById('CustomerNo');
        var preview = document.getElementById('customerPreview');
        if (no && preview) {
            var timer;
            function lookup() {
                var v = no.value.trim();
                if (!v) { preview.textContent = 'Type a customer number'; preview.className = 'form-control bg-200 text-muted'; return; }
                fetch('@Url.Action("LookupCustomer", "Account")?customerNo=' + encodeURIComponent(v))
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.found) { preview.textContent = 'No customer found'; preview.className = 'form-control bg-200 text-danger'; return; }
                        preview.textContent = d.name + ' (' + d.status + ')';
                        preview.className = 'form-control bg-200 ' + (d.status === 'ACTIVE' ? 'text-success' : 'text-warning');
                    })
                    .catch(function () { });
            }
            no.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(lookup, 350); });
            if (no.value) lookup();
        }
    })();
</script>
