@* src/Microbanker.Web/Views/Account/View.cshtml *@
@model Microbanker.Web.Models.AccountDetailViewModel
@{
    ViewData["Title"]        = Model.AccountNo;
    ViewData["PageTitle"]    = Model.AccountNo;
    ViewData["PageSubTitle"] = Model.AccountName;
    var open = Model.Status is "ACTIVE" or "DORMANT" or "FROZEN";
    string? Gl(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;
    void Row(string label, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }
        <div class="col-md-4 mb-3">
            <div class="fs--2 text-500 text-uppercase">@label</div>
            <div class="fw-medium">@value</div>
        </div>
    }
}
@functions {
    static string Badge(string status) => status switch
    {
        "ACTIVE" or "APPROVED"            => "badge-subtle-success",
        "PENDING"                         => "badge-subtle-warning",
        "FROZEN" or "REJECTED"            => "badge-subtle-danger",
        "DORMANT"                         => "badge-subtle-info",
        _                                 => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">@Model.AccountName <span class="badge @Badge(Model.Status) ms-2">@Model.Status</span></h5>
            <div class="fs--1 text-muted">
                @Model.AccountNo · @Model.AccountType.Replace("_", " ") · @Model.ProductName · @Model.BranchName ·
                <a asp-controller="Customer" asp-action="View" asp-route-id="@Model.CustomerEncryptedId">@Model.CustomerNo @Model.CustomerName</a>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-falcon-default btn-sm">Back</a>
            @if (Model.CanEditNow)
            {
                <a asp-action="Edit" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm"><i class="fas fa-pencil-alt me-1"></i>Edit</a>
            }
            @if (open)
            {
                <a asp-action="MiniStatement" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm"><i class="fas fa-receipt me-1"></i>Mini statement</a>
                <a asp-action="BlockAmount" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm"><i class="fas fa-lock me-1"></i>Block / release</a>
            }
            @if (Model.Status == "ACTIVE" || Model.Status == "DORMANT")
            {
                <form asp-action="Freeze" asp-route-id="@Model.EncryptedId" method="post" class="d-inline" onsubmit="return confirm('Freeze this account?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-warning btn-sm" type="submit"><i class="fas fa-snowflake me-1"></i>Freeze</button>
                </form>
            }
            @if (Model.Status == "FROZEN")
            {
                <form asp-action="Unfreeze" asp-route-id="@Model.EncryptedId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-success btn-sm" type="submit"><i class="fas fa-sun me-1"></i>Unfreeze</button>
                </form>
            }
            @if (open)
            {
                <form asp-action="Close" asp-route-id="@Model.EncryptedId" method="post" class="d-inline" onsubmit="return confirm('Close this account? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-danger btn-sm" type="submit"><i class="fas fa-ban me-1"></i>Close</button>
                </form>
            }
            @if (Model.Status == "PENDING")
            {
                <form asp-action="Delete" asp-route-id="@Model.EncryptedId" method="post" class="d-inline" onsubmit="return confirm('Delete this pending account?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-danger btn-sm" type="submit"><i class="fas fa-trash-alt me-1"></i>Delete</button>
                </form>
            }
        </div>
    </div>
</div>

@if (Model.Status == "PENDING")
{
    <div class="card shadow-sm border-0 mb-3 border-start border-warning border-3">
        <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
            <div><h6 class="fw-semibold mb-1"><i class="fas fa-hourglass-half me-2 text-warning"></i>Awaiting approval</h6>
                <div class="fs--1 text-muted">Opening balance @Model.OpeningBalance.ToString("N2") @Model.Currency becomes the book balance once approved.</div></div>
            <form asp-action="Approve" asp-route-id="@Model.EncryptedId" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-success btn-sm" type="submit"><i class="fas fa-check me-1"></i>Approve account</button>
            </form>
        </div>
    </div>
}
else if (Model.IsApproved)
{
    <div class="alert alert-light border fs--1 py-2">
        <i class="fas fa-check-circle text-success me-2"></i>Approved @Model.ApprovedAt?.ToString("dd MMM yyyy HH:mm")
        @if (!string.IsNullOrEmpty(Model.ApprovedByName)) { <span>by @Model.ApprovedByName</span> }
    </div>
}

@if (Model.OpenEditRequest != null)
{
    var req = Model.OpenEditRequest;
    <div class="card shadow-sm border-0 mb-3 border-start @(req.Status == "APPROVED" ? "border-success" : "border-info") border-3">
        <div class="card-body">
            <h6 class="fw-semibold mb-2"><i class="fas fa-edit me-2 text-info"></i>Edit request <span class="badge @Badge(req.Status) ms-1">@req.Status</span></h6>
            <div class="fs--1 mb-2">@req.Reason <span class="text-muted">— @req.RequestedByName, @req.RequestedAt.ToString("dd MMM yyyy")</span></div>
            @if (req.Status == "PENDING")
            {
                <div class="row g-2">
                    <div class="col-md-8">
                        <form asp-action="RejectEditRequest" asp-route-id="@Model.EncryptedId" method="post" class="row g-2">
                            @Html.AntiForgeryToken()
                            <div class="col-md-8"><input name="remarks" class="form-control form-control-sm" maxlength="500" placeholder="Remarks (required to reject)" /></div>
                            <div class="col-md-4"><button class="btn btn-falcon-danger btn-sm w-100" type="submit"><i class="fas fa-times me-1"></i>Reject</button></div>
                        </form>
                    </div>
                    <div class="col-md-4">
                        <form asp-action="ApproveEditRequest" asp-route-id="@Model.EncryptedId" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-success btn-sm w-100" type="submit"><i class="fas fa-check me-1"></i>Approve request</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="fs--1 text-muted">Approved by @req.ReviewedByName. Use <strong>Edit</strong> to make the change; the approval can be used once.</div>
            }
        </div>
    </div>
}
else if (open)
{
    <details class="mb-3">
        <summary class="fs--1 text-primary" style="cursor:pointer">Request a change to this account</summary>
        <form asp-action="RequestEdit" asp-route-id="@Model.EncryptedId" method="post" class="row g-2 mt-1">
            @Html.AntiForgeryToken()
            <div class="col-md-9"><input name="reason" class="form-control form-control-sm" maxlength="500" placeholder="Why does this account need to change?" required /></div>
            <div class="col-md-3"><button class="btn btn-falcon-default btn-sm w-100" type="submit">Submit request</button></div>
        </form>
    </details>
}

<partial name="_Balances" model="Model" />

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-transparent border-bottom py-2"><h6 class="mb-0 fw-semibold fs--1"><i class="fas fa-chart-line me-2 text-primary"></i>Position &amp; Activity</h6></div>
    <div class="card-body pb-0"><div class="row">
        @{ Row("Opening balance", Model.OpeningBalance.ToString("N2")); Row("Unauthorised debits", Model.UnauthorizedDR.ToString("N2")); Row("Unauthorised credits", Model.UnauthorizedCR.ToString("N2"));
           Row("Monthly debit turnover", Model.MonthlyDRTurnover.ToString("N2")); Row("Monthly credit turnover", Model.MonthlyCRTurnover.ToString("N2"));
           Row("Interest accrued (debit)", Model.InterestAccruedDR.ToString("N2")); Row("Interest accrued (credit)", Model.InterestAccruedCR.ToString("N2"));
           Row("Last debit", Model.LastDRDate?.ToString("dd MMM yyyy")); Row("Last credit", Model.LastCRDate?.ToString("dd MMM yyyy"));
           Row("Open date", Model.OpenDate.ToString("dd MMM yyyy")); Row("Closed", Model.ClosedAt?.ToString("dd MMM yyyy"));
           Row("Created by", Model.CreatedByName); }
    </div></div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-transparent border-bottom py-2"><h6 class="mb-0 fw-semibold fs--1"><i class="fas fa-sliders-h me-2 text-primary"></i>Settings &amp; GL Mapping</h6></div>
    <div class="card-body pb-0"><div class="row">
        @{ Row("ATM account no.", Model.AtmAccountNo); Row("ATM daily limit", Model.AtmDailyLimit > 0 ? Model.AtmDailyLimit.ToString("N2") : null);
           Row("Sector", Model.SectorName); Row("Sub-sector", Model.SubSectorName);
           Row("Liability control GL", Gl(Model.GLLiabilityControl)); Row("Asset control GL", Gl(Model.GLAssetControl));
           Row("Income GL", Gl(Model.GLIncomeAccount)); Row("Expense GL", Gl(Model.GLExpenseAccount));
           Row("Charge GL", Gl(Model.GLChargeAccount)); Row("Fee GL", Gl(Model.GLFeeAccount)); }
    </div></div>
</div>
