@model Microbanker.Web.Models.RoleFormModel
@{
    ViewData["Title"] = "Edit Role";
}
<div class="row mb-3">
    <div class="col"><h4 class="mb-0"><i class="fas fa-shield-alt me-2 text-primary"></i>Edit Role</h4></div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
        {
            <div class="alert alert-danger py-2">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
        }
        <form method="post" asp-action="Edit" asp-route-id="@Model.EncryptedId">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_RoleForm", Model)
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
