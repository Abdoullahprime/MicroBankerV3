@* src/Microbanker.Web/Views/Teller/RetailPosting.cshtml *@
@model Microbanker.Web.Models.RetailPostingFormModel
@{
    ViewData["Title"]        = "Retail Posting";
    ViewData["PageTitle"]    = "Retail Posting";
    ViewData["PageSubTitle"] = "Move money from one account to another";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0" style="max-width:880px;">
    <div class="card-header bg-transparent border-bottom py-3"><h6 class="mb-0 fw-semibold"><i class="fas fa-exchange-alt me-2 text-primary"></i>Account to account</h6></div>
    <div class="card-body">
        <form asp-action="RetailPosting" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs--1"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FromAccountNo" class="form-label fw-medium"></label>
                    <input asp-for="FromAccountNo" class="form-control text-uppercase" autocomplete="off" data-account-lookup />
            <div class="form-text acct-preview"></div>
            <span asp-validation-for="FromAccountNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ToAccountNo" class="form-label fw-medium"></label>
                    <input asp-for="ToAccountNo" class="form-control text-uppercase" autocomplete="off" data-account-lookup />
            <div class="form-text acct-preview"></div>
            <span asp-validation-for="ToAccountNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DebitCodeId" class="form-label fw-medium"></label>
                    <select asp-for="DebitCodeId" asp-items="Model.DebitCodes" class="form-select"><option value="">— Select —</option></select>
                    <span asp-validation-for="DebitCodeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CreditCodeId" class="form-label fw-medium"></label>
                    <select asp-for="CreditCodeId" asp-items="Model.CreditCodes" class="form-select"><option value="">— Select —</option></select>
                    <span asp-validation-for="CreditCodeId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label fw-medium"></label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ValueDate" class="form-label fw-medium"></label>
                    <input asp-for="ValueDate" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="TellerRef" class="form-label fw-medium"></label>
                    <input asp-for="TellerRef" class="form-control" maxlength="50" />
                </div>
                <div class="col-12">
                    <label asp-for="Narration" class="form-label fw-medium"></label>
                    <input asp-for="Narration" class="form-control" maxlength="250" />
                    <span asp-validation-for="Narration" class="text-danger small"></span>
                </div>
            </div>
            <hr class="my-4" />
            <button type="submit" class="btn btn-primary"><i class="fas fa-check me-2"></i>Post transfer</button>
            <div class="fs--1 text-muted mt-2">Both accounts must be in the same currency. The two legs post together or not at all.</div>
        </form>
    </div>
</div>
<partial name="_AccountLookup" />
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
