@* src/Microbanker.Web/Views/Teller/WithdrawalRequests.cshtml *@
@model Microbanker.Web.Models.WithdrawalRequestListViewModel
@{
    ViewData["Title"]        = "Withdrawal Requests";
    ViewData["PageTitle"]    = "Withdrawal Requests";
    ViewData["PageSubTitle"] = "Withdrawals that need approval before cash is paid out";
}
@functions {
    static string Badge(string status) => status switch
    {
        "POSTED" or "APPROVED" or "COMPLETED" => "badge-subtle-success",
        "PENDING"                             => "badge-subtle-warning",
        "REVERSED" or "REJECTED"              => "badge-subtle-danger",
        _                                     => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom py-2 d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="status" asp-items="Model.Statuses" class="form-select form-select-sm" style="width:150px"><option value="">All statuses</option></select>
            <button class="btn btn-falcon-default btn-sm" type="submit"><i class="fas fa-filter me-1"></i>Filter</button>
        </form>
        <a asp-action="Withdrawal" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> New withdrawal</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="text-center py-5 text-muted"><i class="fas fa-hand-holding-usd fa-3x mb-3 opacity-25"></i><p class="mb-0 fs--1">No withdrawal requests.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0 fs--1 align-middle">
                    <thead class="bg-200"><tr><th>Account</th><th class="text-end">Amount</th><th>Code</th><th>Purpose</th><th>Requested</th><th class="text-center">Status</th><th style="min-width:300px">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="fw-medium">@r.AccountNo <span class="text-muted fw-normal">@r.AccountName</span></td>
                            <td class="text-end">@r.Amount.ToString("N2") <span class="text-muted">@r.Currency</span></td>
                            <td class="text-muted">@r.CodeLabel</td>
                            <td class="text-muted">@r.Purpose</td>
                            <td class="text-muted">@r.CreatedAt.ToString("dd MMM yyyy") <span class="d-block fs--2">@r.RequestedByName</span></td>
                            <td class="text-center">
                                <span class="badge @Badge(r.Status)">@r.Status</span>
                                @if (!string.IsNullOrEmpty(r.ReviewedByName)) { <div class="fs--2 text-muted">@r.ReviewedByName</div> }
                                @if (!string.IsNullOrEmpty(r.ReviewRemarks)) { <div class="fs--2 text-muted">@r.ReviewRemarks</div> }
                                @if (!string.IsNullOrEmpty(r.CompletedTransactionRef)) { <div class="fs--2 text-muted">@r.CompletedTransactionRef</div> }
                            </td>
                            <td>
                                @if (r.Status == "PENDING")
                                {
                                    <div class="d-flex gap-1">
                                        <form asp-action="ApproveWithdrawal" asp-route-id="@r.EncryptedId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-falcon-success btn-sm py-0 px-2" type="submit"><i class="fas fa-check me-1"></i>Approve</button>
                                        </form>
                                        <form asp-action="RejectWithdrawal" asp-route-id="@r.EncryptedId" method="post" class="d-inline"
                                              onsubmit="var t = prompt('Reason for rejecting this withdrawal?'); if (!t) return false; this.remarks.value = t; return true;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="remarks" />
                                            <button class="btn btn-falcon-danger btn-sm py-0 px-2" type="submit"><i class="fas fa-times me-1"></i>Reject</button>
                                        </form>
                                    </div>
                                }
                                else if (r.Status == "APPROVED")
                                {
                                    <form asp-action="PayWithdrawal" asp-route-id="@r.EncryptedId" method="post" class="d-flex gap-1"
                                          onsubmit="return confirm('Pay out ' + '@r.Amount.ToString("N2")' + ' from @r.AccountNo?');">
                                        @Html.AntiForgeryToken()
                                        <select name="cashGlAccountNo" asp-items="Model.CashGLs" class="form-select form-select-sm" required><option value="">Cash account…</option></select>
                                        <button class="btn btn-primary btn-sm py-0 px-2" type="submit"><i class="fas fa-money-bill-wave me-1"></i>Pay out</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top fs--1">
                <span class="text-muted">@Model.TotalCount request(s) · page @Model.Page of @Model.TotalPages</span>
                <div class="btn-group">
                    <a class="btn btn-falcon-default btn-sm @(Model.Page <= 1 ? "disabled" : "")" asp-action="WithdrawalRequests" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status">Previous</a>
                    <a class="btn btn-falcon-default btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-action="WithdrawalRequests" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status">Next</a>
                </div>
            </div>
        }
    </div>
</div>
