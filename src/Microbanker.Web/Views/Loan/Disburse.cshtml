@* src/Microbanker.Web/Views/Loan/Disburse.cshtml *@
@model Microbanker.Web.Models.DisburseViewModel
@{
    ViewData["Title"]        = "Disburse Loan";
    ViewData["PageTitle"]    = "Disburse Loan";
    ViewData["PageSubTitle"] = Model.Loan.LoanNo + " · " + Model.Loan.LoanName;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="alert alert-light border fs--1 py-2"><i class="fas fa-info-circle me-2 text-primary"></i>This records the loan side only. Crediting or debiting a member account is not posted until the transaction module (Phase 5).</div>

<div class="card shadow-sm border-0 mb-3" style="max-width:760px;">
    <div class="card-body">
        <div class="row mb-3 text-center">
            <div class="col-4"><div class="fs--2 text-500 text-uppercase">Amount</div><div class="fs-4 fw-bold">@Model.Loan.LoanAmount.ToString("N2") @Model.Loan.Currency</div></div>
            <div class="col-4"><div class="fs--2 text-500 text-uppercase">Total payable</div><div class="fs-4 fw-bold">@Model.Loan.TotalPayable.ToString("N2")</div></div>
            <div class="col-4"><div class="fs--2 text-500 text-uppercase">Installments</div><div class="fs-4 fw-bold">@Model.Loan.NoOfInstallments</div></div>
        </div>
        <form asp-action="Disburse" asp-route-id="@Model.Loan.EncryptedId" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label asp-for="DisbursementDate" class="form-label fw-medium"></label>
                <input asp-for="DisbursementDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="FirstEmiDate" class="form-label fw-medium"></label>
                <input asp-for="FirstEmiDate" class="form-control" type="date" />
                <div class="form-text">Empty = calculated from the disbursement date.</div>
            </div>
            <div class="col-md-4 d-flex align-items-start gap-2">
                <button class="btn btn-success mt-4" type="submit" onclick="return confirm('Disburse this loan and create its repayment schedule?');"><i class="fas fa-check me-1"></i>Disburse</button>
                <a asp-action="View" asp-route-id="@Model.Loan.EncryptedId" class="btn btn-falcon-default mt-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
<partial name="_Schedule" model="Model.Loan" />
