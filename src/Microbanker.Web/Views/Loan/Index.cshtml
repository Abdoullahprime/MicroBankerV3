@* src/Microbanker.Web/Views/Loan/Index.cshtml *@
@model Microbanker.Web.Models.LoanListViewModel
@{
    ViewData["Title"]        = "Loans";
    ViewData["PageTitle"]    = "Loans";
    ViewData["PageSubTitle"] = "Loan accounts";
}
@functions {
    static string Badge(string status) => status switch
    {
        "ACTIVE" or "APPROVED" or "PAID"  => "badge-subtle-success",
        "PENDING" or "PARTIAL"            => "badge-subtle-warning",
        "REJECTED" or "WRITTEN_OFF"       => "badge-subtle-danger",
        "CONVERTED"                       => "badge-subtle-info",
        _                                 => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom py-2">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                <input name="q" value="@Model.Q" class="form-control form-control-sm" style="width:230px" placeholder="Search loan, name, customer…" />
                <select name="status" asp-items="Model.Statuses" class="form-select form-select-sm" style="width:150px"><option value="">All statuses</option></select>
                <button class="btn btn-falcon-default btn-sm" type="submit"><i class="fas fa-search me-1"></i>Filter</button>
                @if (!string.IsNullOrEmpty(Model.Q) || !string.IsNullOrEmpty(Model.Status)) { <a asp-action="Index" class="btn btn-link btn-sm">Clear</a> }
            </form>
            <div class="d-flex gap-2">
                <a asp-action="BalanceEnquiry" class="btn btn-falcon-default btn-sm"><i class="fas fa-search-dollar me-1"></i>Loan enquiry</a>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> New Loan</a>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="text-center py-5 text-muted"><i class="fas fa-hand-holding-usd fa-3x mb-3 opacity-25"></i><p class="mb-0 fs--1">No loans found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 fs--1">
                    <thead class="bg-200"><tr><th>Loan No.</th><th>Name</th><th>Customer</th><th class="text-end">Amount</th><th class="text-end">Principal outstanding</th><th class="text-center">Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a asp-action="View" asp-route-id="@r.EncryptedId" class="fw-medium">@r.LoanNo</a></td>
                            <td>@r.LoanName</td>
                            <td class="text-muted">@r.CustomerNo</td>
                            <td class="text-end">@r.LoanAmount.ToString("N2") <span class="text-muted">@r.Currency</span></td>
                            <td class="text-end">@r.OutstandingBalance.ToString("N2")</td>
                            <td class="text-center"><span class="badge @Badge(r.Status)">@r.Status.Replace("_", " ")</span></td>
                            <td class="text-end"><a asp-action="View" asp-route-id="@r.EncryptedId" class="btn btn-falcon-default btn-sm py-0 px-2" title="View"><i class="fas fa-eye"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top fs--1">
                <span class="text-muted">@Model.TotalCount loan(s) · page @Model.Page of @Model.TotalPages</span>
                <div class="btn-group">
                    <a class="btn btn-falcon-default btn-sm @(Model.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status" asp-route-q="@Model.Q">Previous</a>
                    <a class="btn btn-falcon-default btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status" asp-route-q="@Model.Q">Next</a>
                </div>
            </div>
        }
    </div>
</div>
