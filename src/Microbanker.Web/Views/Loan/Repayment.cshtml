@* src/Microbanker.Web/Views/Loan/Repayment.cshtml *@
@model Microbanker.Web.Models.RepaymentViewModel
@{
    ViewData["Title"]        = "Loan Repayment";
    ViewData["PageTitle"]    = "Loan Repayment";
    ViewData["PageSubTitle"] = Model.Loan.LoanNo + " · " + Model.Loan.LoanName;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="alert alert-light border fs--1 py-2"><i class="fas fa-info-circle me-2 text-primary"></i>This records the loan side only. Crediting or debiting a member account is not posted until the transaction module (Phase 5).</div>

<partial name="_Summary" model="Model.Loan" />
<div class="card shadow-sm border-0 mb-3" style="max-width:860px;">
    <div class="card-header bg-transparent border-bottom py-2"><h6 class="mb-0 fw-semibold fs--1"><i class="fas fa-coins me-2 text-primary"></i>Take a repayment</h6></div>
    <div class="card-body">
        <form asp-action="Repayment" asp-route-id="@Model.Loan.EncryptedId" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label asp-for="Amount" class="form-label fw-medium"></label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" max="@Model.Loan.TotalRemaining" required />
                <div class="form-text">Up to @Model.Loan.TotalRemaining.ToString("N2"). Paying ahead settles the next installments.</div>
            </div>
            <div class="col-md-3">
                <label asp-for="PaidOn" class="form-label fw-medium"></label>
                <input asp-for="PaidOn" class="form-control" type="date" />
            </div>
            <div class="col-md-3">
                <label asp-for="Mode" class="form-label fw-medium"></label>
                <select asp-for="Mode" asp-items="Model.Modes" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Reference" class="form-label fw-medium"></label>
                <input asp-for="Reference" class="form-control" maxlength="100" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="fas fa-check me-1"></i>Post repayment</button>
                <a asp-action="View" asp-route-id="@Model.Loan.EncryptedId" class="btn btn-falcon-default">Back to loan</a>
            </div>
        </form>
        <div class="fs--1 text-muted mt-3">Each payment is applied to the oldest unpaid installment first: charges, then interest, then principal.</div>
    </div>
</div>
<partial name="_Schedule" model="Model.Loan" />
