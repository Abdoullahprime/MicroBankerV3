@* src/Microbanker.Web/Views/Area/Edit.cshtml *@
@model Microbanker.Web.Models.AreaFormModel
@{
    ViewData["Title"]        = "Edit Area";
    ViewData["PageTitle"]    = "Edit Area";
    ViewData["PageSubTitle"] = "Update area details";
}

<div class="card shadow-sm border-0" style="max-width:720px;">
    <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Area Details</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.EncryptedId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 fs--1"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="RegionId" class="form-label fw-medium"></label>
                    <select asp-for="RegionId" asp-items="Model.Regions" class="form-select" id="regionSelect">
                        <option value="">— Select region —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="DistrictId" class="form-label fw-medium"></label>
                    <select asp-for="DistrictId" class="form-select" id="districtSelect">
                        <option value="">— Select district —</option>
                        @foreach (var d in Model.Districts)
                        {
                            <option value="@d.Id" data-region="@d.RegionId">@d.Name</option>
                        }
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-medium"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label fw-medium"></label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Update Area
                </button>
                <a asp-action="Index" class="btn btn-falcon-default">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var region = document.getElementById('regionSelect');
            var district = document.getElementById('districtSelect');
            function filter() {
                var r = region.value;
                Array.prototype.forEach.call(district.options, function (o) {
                    if (!o.value) return;
                    var show = !r || o.getAttribute('data-region') === r;
                    o.hidden = !show; o.disabled = !show;
                });
                var sel = district.options[district.selectedIndex];
                if (sel && sel.disabled) district.value = '';
            }
            region.addEventListener('change', filter);
            filter();
        })();
    </script>
}
