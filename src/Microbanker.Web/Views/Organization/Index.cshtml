@model Microbanker.Web.Models.OrganizationViewModel
@{
    ViewData["Title"] = "Organization";
    ViewData["PageTitle"] = "Organization";
    ViewData["PageSubTitle"] = "Company organizational profile";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.HasOrganization)
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <div class="mb-4">
                <i class="fas fa-building fa-4x text-muted opacity-50"></i>
            </div>
            <h5 class="text-muted mb-2">No Organization Set Up</h5>
            <p class="text-muted mb-4">Create your organization profile to get started with Microbanker setup.</p>
            <a asp-action="Create" class="btn btn-primary px-4">
                <i class="fas fa-plus me-2"></i>Create Organization
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Header Card -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center py-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;">
                            <i class="fas fa-building text-primary fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-semibold">@Model.Name</h5>
                            @if (!string.IsNullOrEmpty(Model.ShortName))
                            {
                                <span class="badge bg-primary bg-opacity-15 text-primary">@Model.ShortName</span>
                            }
                        </div>
                    </div>
                    <a asp-action="Edit" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm">
                        <i class="fas fa-pencil-alt me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>

        <!-- Basic Info -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-semibold"><i class="fas fa-info-circle me-2 text-primary"></i>Basic Information</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @if (!string.IsNullOrEmpty(Model.Industry))
                        {
                            <dt class="col-sm-5 text-muted fw-normal">Industry</dt>
                            <dd class="col-sm-7">@Model.Industry</dd>
                        }
                        @if (Model.EstablishedDate.HasValue)
                        {
                            <dt class="col-sm-5 text-muted fw-normal">Established</dt>
                            <dd class="col-sm-7">@Model.EstablishedDate.Value.ToString("dd MMM yyyy")</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.RegistrationNumber))
                        {
                            <dt class="col-sm-5 text-muted fw-normal">Reg. Number</dt>
                            <dd class="col-sm-7">@Model.RegistrationNumber</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.TaxNumber))
                        {
                            <dt class="col-sm-5 text-muted fw-normal">Tax Number</dt>
                            <dd class="col-sm-7">@Model.TaxNumber</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Contact -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-semibold"><i class="fas fa-address-card me-2 text-primary"></i>Contact Details</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <dt class="col-sm-4 text-muted fw-normal">Address</dt>
                            <dd class="col-sm-8">@Model.Address</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <dt class="col-sm-4 text-muted fw-normal">Phone</dt>
                            <dd class="col-sm-8">@Model.Phone</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <dt class="col-sm-4 text-muted fw-normal">Email</dt>
                            <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <dt class="col-sm-4 text-muted fw-normal">Website</dt>
                            <dd class="col-sm-8"><a href="@Model.Website" target="_blank">@Model.Website</a></dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
}
