@* src/Microbanker.Web/Views/Customer/View.cshtml *@
@model Microbanker.Web.Models.CustomerDetailViewModel
@{
    ViewData["Title"]        = Model.DisplayName;
    ViewData["PageTitle"]    = Model.DisplayName;
    ViewData["PageSubTitle"] = Model.CustomerNo;
}
@functions {
    static string Badge(string status) => status switch
    {
        "ACTIVE" or "APPROVED"   => "badge-subtle-success",
        "PENDING"                => "badge-subtle-warning",
        "SUSPENDED" or "REJECTED" => "badge-subtle-danger",
        _                        => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">@Model.DisplayName <span class="badge @Badge(Model.Status) ms-2">@Model.Status</span></h5>
            <div class="fs--1 text-muted">
                @Model.CustomerNo · @Model.CustomerType · @Model.BranchName · created @Model.CreatedAt.ToString("dd MMM yyyy")
                @if (!string.IsNullOrEmpty(Model.CreatedByName)) { <span>by @Model.CreatedByName</span> }
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-falcon-default btn-sm">Back</a>
            @if (Model.Status != "CLOSED")
            {
                <a asp-action="Edit" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm"><i class="fas fa-pencil-alt me-1"></i>Edit</a>
            }
            @if (Model.Status == "ACTIVE")
            {
                <form asp-action="Suspend" asp-route-id="@Model.EncryptedId" method="post" class="d-inline" onsubmit="return confirm('Suspend this customer?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-warning btn-sm" type="submit"><i class="fas fa-pause me-1"></i>Suspend</button>
                </form>
            }
            @if (Model.Status == "SUSPENDED")
            {
                <form asp-action="Reactivate" asp-route-id="@Model.EncryptedId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-success btn-sm" type="submit"><i class="fas fa-play me-1"></i>Reactivate</button>
                </form>
            }
            @if (Model.Status == "PENDING")
            {
                <form asp-action="Delete" asp-route-id="@Model.EncryptedId" method="post" class="d-inline" onsubmit="return confirm('Delete this pending customer?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-danger btn-sm" type="submit"><i class="fas fa-trash-alt me-1"></i>Delete</button>
                </form>
            }
        </div>
    </div>
</div>

@if (Model.Status == "PENDING")
{
    <div class="card shadow-sm border-0 mb-3 border-start border-warning border-3">
        <div class="card-body">
            <h6 class="fw-semibold mb-2"><i class="fas fa-hourglass-half me-2 text-warning"></i>Awaiting approval</h6>
            <form asp-action="Approve" asp-route-id="@Model.EncryptedId" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-9">
                    <label class="form-label fs--1 mb-1">Remarks (optional)</label>
                    <input name="remarks" class="form-control form-control-sm" maxlength="500" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-success btn-sm w-100" type="submit"><i class="fas fa-check me-1"></i>Approve customer</button>
                </div>
            </form>
        </div>
    </div>
}
else if (Model.IsApproved)
{
    <div class="alert alert-light border fs--1 py-2">
        <i class="fas fa-check-circle text-success me-2"></i>Approved @Model.ApprovedAt?.ToString("dd MMM yyyy HH:mm")
        @if (!string.IsNullOrEmpty(Model.ApprovedByName)) { <span>by @Model.ApprovedByName</span> }
        @if (!string.IsNullOrEmpty(Model.ApprovalRemarks)) { <span> — @Model.ApprovalRemarks</span> }
    </div>
}

<partial name="_ProfileDetails" model="(Microbanker.Web.Models.ProfileDetailViewModel)Model" />
