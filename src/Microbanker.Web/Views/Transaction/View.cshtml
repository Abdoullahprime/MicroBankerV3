@* src/Microbanker.Web/Views/Transaction/View.cshtml *@
@model Microbanker.Web.Models.TransactionDetailViewModel
@{
    var t = Model.Txn;
    ViewData["Title"]        = t.TransactionRef;
    ViewData["PageTitle"]    = t.TransactionRef;
    ViewData["PageSubTitle"] = t.Narration;
    void Row(string label, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }
        <div class="col-md-4 mb-3"><div class="fs--2 text-500 text-uppercase">@label</div><div class="fw-medium">@value</div></div>
    }
}
@functions {
    static string Badge(string status) => status switch
    {
        "POSTED" or "APPROVED" or "COMPLETED" => "badge-subtle-success",
        "PENDING"                             => "badge-subtle-warning",
        "REVERSED" or "REJECTED"              => "badge-subtle-danger",
        _                                     => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">
                <span class="badge @(t.DrCr == "DR" ? "badge-subtle-warning" : "badge-subtle-success") me-2">@t.DrCr</span>@t.Amount.ToString("N2") @t.Currency
                <span class="badge @Badge(t.Status) ms-2">@t.Status</span>
                @if (t.IsReversal) { <span class="badge badge-subtle-info ms-1">REVERSAL</span> }
            </h5>
            <div class="fs--1 text-muted">@t.AccountNo @t.AccountName · value date @t.ValueDate.ToString("dd MMM yyyy") · balance after @t.BalanceAfter.ToString("N2")</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-falcon-default btn-sm">Back</a>
            <a asp-controller="Account" asp-action="View" asp-route-id="@Model.AccountEncryptedId" class="btn btn-falcon-default btn-sm">Account</a>
        </div>
    </div>
</div>

@if (Model.CanReverse)
{
    <div class="card shadow-sm border-0 mb-3 border-start border-danger border-3">
        <div class="card-body">
            <h6 class="fw-semibold mb-2"><i class="fas fa-undo me-2 text-danger"></i>Reverse this transaction@(Model.BatchRef != null ? " (the whole batch)" : "")</h6>
            <form asp-action="Reverse" asp-route-id="@t.EncryptedId" method="post" class="row g-2"
                  onsubmit="return confirm('Reverse this @(Model.BatchRef != null ? "batch" : "transaction")? Offsetting entries will be posted.');">
                @Html.AntiForgeryToken()
                <div class="col-md-9"><input name="reason" class="form-control form-control-sm" maxlength="200" placeholder="Reason for the reversal (required)" required /></div>
                <div class="col-md-3"><button class="btn btn-falcon-danger btn-sm w-100" type="submit">Reverse</button></div>
            </form>
        </div>
    </div>
}
@if (Model.ReversalRef != null)
{
    <div class="alert alert-light border fs--1 py-2">
        <i class="fas fa-undo text-info me-2"></i>
        @if (t.IsReversal) { <span>This reverses </span> } else { <span>Reversed by </span> }
        @if (Model.ReversalEncryptedId != null) { <a asp-action="View" asp-route-id="@Model.ReversalEncryptedId" class="fw-medium">@Model.ReversalRef</a> } else { <strong>@Model.ReversalRef</strong> }
        @if (!t.IsReversal && Model.ReversedAt != null) { <span> on @Model.ReversedAt?.ToString("dd MMM yyyy HH:mm") @(string.IsNullOrEmpty(Model.ReversedByName) ? "" : "by " + Model.ReversedByName)</span> }
        @if (!string.IsNullOrEmpty(Model.ReversalReason)) { <span> — @Model.ReversalReason</span> }
    </div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-transparent border-bottom py-2"><h6 class="mb-0 fw-semibold fs--1"><i class="fas fa-receipt me-2 text-primary"></i>Details</h6></div>
    <div class="card-body pb-0"><div class="row">
        @{ Row("Reference", t.TransactionRef); Row("Transaction code", Model.CodeLabel); Row("Branch", Model.BranchName);
           Row("Posted", t.PostingDate.ToString("dd MMM yyyy HH:mm") + " UTC"); Row("Posted by", Model.PostedByName); Row("Teller / slip ref.", Model.TellerRef);
           Row("Batch", Model.BatchRef); Row("Posted against (GL)", Model.GLAccountNo == null ? null : Model.GLAccountNo + (string.IsNullOrEmpty(Model.GLAccountName) ? "" : " — " + Model.GLAccountName)); }
    </div></div>
</div>

@if (Model.BatchLegs.Count > 1)
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-transparent border-bottom py-2"><h6 class="mb-0 fw-semibold fs--1"><i class="fas fa-layer-group me-2 text-primary"></i>Posted together</h6></div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 fs--1">
                <thead class="bg-200"><tr><th>Ref</th><th>Account</th><th class="text-center">Dr/Cr</th><th class="text-end">Amount</th><th class="text-center">Status</th></tr></thead>
                <tbody>
                @foreach (var l in Model.BatchLegs)
                {
                    <tr class="@(l.TransactionRef == t.TransactionRef ? "table-active" : "")">
                        <td><a asp-action="View" asp-route-id="@l.EncryptedId">@l.TransactionRef</a></td>
                        <td>@l.AccountNo <span class="text-muted">@l.AccountName</span></td>
                        <td class="text-center"><span class="badge @(l.DrCr == "DR" ? "badge-subtle-warning" : "badge-subtle-success")">@l.DrCr</span></td>
                        <td class="text-end">@l.Amount.ToString("N2") @l.Currency</td>
                        <td class="text-center"><span class="badge @Badge(l.Status)">@l.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
