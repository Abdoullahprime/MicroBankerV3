@* src/Microbanker.Web/Views/Transaction/Index.cshtml *@
@model Microbanker.Web.Models.TransactionListViewModel
@{
    ViewData["Title"]        = "Transactions";
    ViewData["PageTitle"]    = "Transactions";
    ViewData["PageSubTitle"] = "Search and review postings";
}
@functions {
    static string Badge(string status) => status switch
    {
        "POSTED" or "APPROVED" or "COMPLETED" => "badge-subtle-success",
        "PENDING"                             => "badge-subtle-warning",
        "REVERSED" or "REJECTED"              => "badge-subtle-danger",
        _                                     => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom py-2">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <input name="q" value="@Model.Q" class="form-control form-control-sm" style="width:220px" placeholder="Ref, account, narration…" />
            <select name="status" asp-items="Model.Statuses" class="form-select form-select-sm" style="width:130px"><option value="">All statuses</option></select>
            <select name="drCr" class="form-select form-select-sm" style="width:100px">
                <option value="">DR + CR</option>
                <option value="DR" selected="@(Model.DrCr == "DR")">DR</option>
                <option value="CR" selected="@(Model.DrCr == "CR")">CR</option>
            </select>
            <input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:140px" title="Value date from" />
            <input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:140px" title="Value date to" />
            <button class="btn btn-falcon-default btn-sm" type="submit"><i class="fas fa-search me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-link btn-sm">Clear</a>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="text-center py-5 text-muted"><i class="fas fa-list-alt fa-3x mb-3 opacity-25"></i><p class="mb-0 fs--1">No transactions found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 fs--1">
                    <thead class="bg-200"><tr><th>Ref</th><th>Value date</th><th>Account</th><th>Narration</th><th class="text-center">Dr/Cr</th><th class="text-end">Amount</th><th class="text-end">Balance after</th><th class="text-center">Status</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a asp-action="View" asp-route-id="@r.EncryptedId" class="fw-medium">@r.TransactionRef</a>@if (r.IsReversal) { <span class="badge badge-subtle-info ms-1">REVERSAL</span> }</td>
                            <td class="text-muted">@r.ValueDate.ToString("dd MMM yyyy")</td>
                            <td>@r.AccountNo <span class="text-muted">@r.AccountName</span></td>
                            <td class="text-muted">@r.Narration</td>
                            <td class="text-center"><span class="badge @(r.DrCr == "DR" ? "badge-subtle-warning" : "badge-subtle-success")">@r.DrCr</span></td>
                            <td class="text-end fw-medium">@r.Amount.ToString("N2") <span class="text-muted">@r.Currency</span></td>
                            <td class="text-end text-muted">@r.BalanceAfter.ToString("N2")</td>
                            <td class="text-center"><span class="badge @Badge(r.Status)">@r.Status</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center px-3 py-2 border-top fs--1">
                <span class="text-muted">@Model.TotalCount transaction(s) · page @Model.Page of @Model.TotalPages ·
                    standing debits <strong>@Model.TotalDebits.ToString("N2")</strong> · standing credits <strong>@Model.TotalCredits.ToString("N2")</strong></span>
                <div class="btn-group">
                    <a class="btn btn-falcon-default btn-sm @(Model.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Q" asp-route-status="@Model.Status" asp-route-drCr="@Model.DrCr" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Previous</a>
                    <a class="btn btn-falcon-default btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Q" asp-route-status="@Model.Status" asp-route-drCr="@Model.DrCr" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Next</a>
                </div>
            </div>
        }
    </div>
</div>
