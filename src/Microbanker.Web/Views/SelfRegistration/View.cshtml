@* src/Microbanker.Web/Views/SelfRegistration/View.cshtml *@
@model Microbanker.Web.Models.SelfRegDetailViewModel
@{
    ViewData["Title"]        = Model.DisplayName;
    ViewData["PageTitle"]    = Model.DisplayName;
    ViewData["PageSubTitle"] = "Self-registration";
}
@functions {
    static string Badge(string status) => status switch
    {
        "ACTIVE" or "APPROVED"   => "badge-subtle-success",
        "PENDING"                => "badge-subtle-warning",
        "SUSPENDED" or "REJECTED" => "badge-subtle-danger",
        _                        => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">@Model.DisplayName <span class="badge @Badge(Model.Status) ms-2">@Model.Status</span></h5>
            <div class="fs--1 text-muted">@Model.CustomerType · @Model.BranchName · submitted @Model.CreatedAt.ToString("dd MMM yyyy")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-falcon-default btn-sm">Back</a>
            @if (Model.Status == "PENDING")
            {
                <a asp-action="Edit" asp-route-id="@Model.EncryptedId" class="btn btn-falcon-default btn-sm"><i class="fas fa-pencil-alt me-1"></i>Edit</a>
            }
            @if (Model.Status != "APPROVED")
            {
                <form asp-action="Delete" asp-route-id="@Model.EncryptedId" method="post" class="d-inline" onsubmit="return confirm('Delete this registration?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-falcon-danger btn-sm" type="submit"><i class="fas fa-trash-alt me-1"></i>Delete</button>
                </form>
            }
        </div>
    </div>
</div>

@if (Model.Status == "PENDING")
{
    <div class="card shadow-sm border-0 mb-3 border-start border-warning border-3">
        <div class="card-body">
            <h6 class="fw-semibold mb-3"><i class="fas fa-hourglass-half me-2 text-warning"></i>Awaiting review</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <form asp-action="Approve" asp-route-id="@Model.EncryptedId" method="post"
                          onsubmit="return confirm('Approve this registration and create the customer?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-success btn-sm w-100" type="submit"><i class="fas fa-check me-1"></i>Approve &amp; create customer</button>
                    </form>
                </div>
                <div class="col-md-8">
                    <form asp-action="Reject" asp-route-id="@Model.EncryptedId" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-md-8"><input name="reason" class="form-control form-control-sm" maxlength="500" placeholder="Reason for rejection (required)" required /></div>
                        <div class="col-md-4"><button class="btn btn-falcon-danger btn-sm w-100" type="submit"><i class="fas fa-times me-1"></i>Reject</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Status == "APPROVED")
{
    <div class="alert alert-light border fs--1 py-2">
        <i class="fas fa-check-circle text-success me-2"></i>Approved @Model.ReviewedAt?.ToString("dd MMM yyyy HH:mm")
        @if (!string.IsNullOrEmpty(Model.ReviewedByName)) { <span>by @Model.ReviewedByName</span> }
        @if (Model.CustomerEncryptedId != null)
        {
            <span> — customer <a asp-controller="Customer" asp-action="View" asp-route-id="@Model.CustomerEncryptedId" class="fw-medium">@Model.CustomerNo</a></span>
        }
    </div>
}
else if (Model.Status == "REJECTED")
{
    <div class="alert alert-light border fs--1 py-2">
        <i class="fas fa-times-circle text-danger me-2"></i>Rejected @Model.ReviewedAt?.ToString("dd MMM yyyy HH:mm")
        @if (!string.IsNullOrEmpty(Model.ReviewedByName)) { <span>by @Model.ReviewedByName</span> }
        @if (!string.IsNullOrEmpty(Model.RejectionReason)) { <span> — @Model.RejectionReason</span> }
    </div>
}

<partial name="_ProfileDetails" model="(Microbanker.Web.Models.ProfileDetailViewModel)Model" />
