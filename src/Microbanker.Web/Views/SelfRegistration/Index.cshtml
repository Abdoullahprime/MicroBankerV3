@* src/Microbanker.Web/Views/SelfRegistration/Index.cshtml *@
@model Microbanker.Web.Models.SelfRegListViewModel
@{
    ViewData["Title"]        = "Self Registration";
    ViewData["PageTitle"]    = "Self Registration";
    ViewData["PageSubTitle"] = "Applications awaiting review";
}
@functions {
    static string Badge(string status) => status switch
    {
        "ACTIVE" or "APPROVED"   => "badge-subtle-success",
        "PENDING"                => "badge-subtle-warning",
        "SUSPENDED" or "REJECTED" => "badge-subtle-danger",
        _                        => "badge-subtle-secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show fs--1" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom py-2 d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="status" asp-items="Model.Statuses" class="form-select form-select-sm" style="width:150px">
                <option value="">All statuses</option>
            </select>
            <button class="btn btn-falcon-default btn-sm" type="submit"><i class="fas fa-filter me-1"></i>Filter</button>
        </form>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> New Registration</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-user-plus fa-3x mb-3 opacity-25"></i>
                <p class="mb-0 fs--1">No registrations found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 fs--1">
                    <thead class="bg-200">
                        <tr><th>Name</th><th>Type</th><th>Branch</th><th>Phone</th><th>Submitted</th><th class="text-center">Status</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a asp-action="View" asp-route-id="@r.EncryptedId" class="fw-medium">@r.DisplayName</a></td>
                            <td class="text-muted">@r.CustomerType</td>
                            <td class="text-muted">@r.BranchName</td>
                            <td class="text-muted">@(r.Phone ?? "—")</td>
                            <td class="text-muted">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-center"><span class="badge @Badge(r.Status)">@r.Status</span></td>
                            <td class="text-end">
                                <a asp-action="View" asp-route-id="@r.EncryptedId" class="btn btn-falcon-default btn-sm py-0 px-2" title="View"><i class="fas fa-eye"></i></a>
                                @if (r.Status == "PENDING")
                                {
                                    <a asp-action="Edit" asp-route-id="@r.EncryptedId" class="btn btn-falcon-default btn-sm py-0 px-2" title="Edit"><i class="fas fa-pencil-alt"></i></a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top fs--1">
                <span class="text-muted">@Model.TotalCount registration(s) · page @Model.Page of @Model.TotalPages</span>
                <div class="btn-group">
                    <a class="btn btn-falcon-default btn-sm @(Model.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status">Previous</a>
                    <a class="btn btn-falcon-default btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status">Next</a>
                </div>
            </div>
        }
    </div>
</div>
